{
  "schema": "pbs-parity-stages/1",
  "schema_version": "1.0.0",
  "description": "Ordered registry of parity capture points. 'order' defines the first diverging stage of a case (lowest order wins). Each stage has exactly one owning domain and at least one requirement ID. keyed_by: '_' (unkeyed), 'bidder', 'seat' or 'bidder#call' (bidder plus zero-based call index in MakeRequests order). trace_field names the trace member holding the stage ('stages' unless the stage is a top-level trace member; 'introspection' for stages compared through GET /__parity/config and /__parity/bidders). go_capture cites the Go source of truth (file:line at the time of writing, plus the anchoring call).",
  "domains": [
    {"id": "endpoints", "order": 1, "requirements": ["ENDP-01", "ENDP-02", "ENDP-03", "ENDP-04", "ENDP-05", "ENDP-06"], "description": "HTTP-visible request/response behaviour of every endpoint."},
    {"id": "config_bootstrap", "order": 2, "requirements": ["CONF-01", "CONF-02"], "description": "Config keys, defaults, env bindings and bidder metadata loading."},
    {"id": "stored_data", "order": 3, "requirements": ["STRD-01", "STRD-02"], "description": "Stored requests/imps/responses and account resolution."},
    {"id": "auction_lifecycle", "order": 4, "requirements": ["AUCT-01", "AUCT-02", "AUCT-04"], "description": "Validation, request shaping, bidder fan-out, response assembly, timeouts."},
    {"id": "policy_privacy_identity", "order": 5, "requirements": ["AUCT-03", "PRIV-01", "IDEN-01"], "description": "Floors, currency, adjustments, targeting, multibid, privacy enforcement, identity."},
    {"id": "bidders_adapters", "order": 6, "requirements": ["BIDD-01", "BIDD-02"], "description": "Adapter request building, outbound calls and response parsing."},
    {"id": "hooks_modules", "order": 7, "requirements": ["MODL-01"], "description": "Module hooks, execution plans and outcomes."},
    {"id": "cache_support_flows", "order": 8, "requirements": ["CACH-01", "CACH-02"], "description": "Prebid Cache writes, stored responses, events and vtrack."},
    {"id": "cutover_proof", "order": 9, "requirements": ["OPER-01", "PARI-01", "PARI-02", "PARI-03", "PARI-04"], "description": "Metrics, analytics and other operational evidence."}
  ],
  "stages": [
    {"id": "config.resolved", "order": 1, "domain": "config_bootstrap", "requirements": ["CONF-01"], "keyed_by": "_", "trace_field": "introspection", "endpoints": ["/__parity/config"], "go_capture": ["config/config.go:756 config.New (resolved Configuration, mapstructure keys, minus adapters/parity)"], "captures": "Resolved host configuration keyed by Go config keys."},
    {"id": "bidders.resolved", "order": 2, "domain": "config_bootstrap", "requirements": ["CONF-02", "BIDD-02"], "keyed_by": "_", "trace_field": "introspection", "endpoints": ["/__parity/bidders"], "go_capture": ["config/config.go:855 applyBidderInfoConfigOverrides", "exchange/adapter_util.go:98 GetActiveBidders", "exchange/adapter_util.go:111 GetDisabledBidderWarningMessages"], "captures": "Resolved bidder infos plus active/disabled maps."},
    {"id": "http.in", "order": 3, "domain": "endpoints", "requirements": ["ENDP-01", "ENDP-02", "ENDP-03"], "keyed_by": "_", "trace_field": "http_in", "endpoints": ["*"], "go_capture": ["parity/server exec handler (request as dispatched to the handler chain)"], "captures": "Inbound method, path, query, headers, body."},
    {"id": "hooks.entrypoint", "order": 4, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:475 ExecuteEntrypointStage", "endpoints/openrtb2/amp_auction.go AmpAuction ExecuteEntrypointStage"], "captures": "Request body after the entrypoint hook stage and its reject error."},
    {"id": "stored.fetch", "order": 5, "domain": "stored_data", "requirements": ["STRD-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:495 after storedRequestFetcher.FetchRequests (:1714)", "endpoints/openrtb2/auction.go:544 refetched when the raw-auction hook changed the payload"], "captures": "{stored_request_id, requests{id:json}, imps{id:json}, errors}."},
    {"id": "account.resolved", "order": 6, "domain": "stored_data", "requirements": ["STRD-02"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video", "/cookie_sync", "/setuid", "/event", "/vtrack"], "go_capture": ["endpoints/openrtb2/auction.go:520 accountService.GetAccount"], "captures": "{id, account (mapstructure dump), errors}."},
    {"id": "hooks.raw_auction", "order": 7, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:527 ExecuteRawAuctionStage"], "captures": "Request body after the raw-auction hook stage."},
    {"id": "request.merged", "order": 8, "domain": "stored_data", "requirements": ["STRD-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:551 processStoredRequests (after the default-request merge at :1761)"], "captures": "Request JSON after stored request/imp merge."},
    {"id": "request.normalized", "order": 9, "domain": "auction_lifecycle", "requirements": ["AUCT-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:595 after ConvertUpTo26 :564, mergeBidderParams :570, setFieldsImplicitly :577, ortb.SetDefaults :582, processInterstitials :588, lmt.ModifyForIOS :594"], "captures": "BidRequest after implicit-field and default processing."},
    {"id": "stored.responses", "order": 10, "domain": "cache_support_flows", "requirements": ["CACH-02"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp"], "go_capture": ["endpoints/openrtb2/auction.go:598 stored_responses.ProcessStoredResponses"], "captures": "{auction{imp:json}, bid{imp:{bidder:json}}, replace_impid}."},
    {"id": "request.validated", "order": 11, "domain": "auction_lifecycle", "requirements": ["AUCT-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:606 validateRequest (snapshot after validation mutations)"], "captures": "{json, errors[], warnings[]}."},
    {"id": "gdpr.context", "order": 12, "domain": "policy_privacy_identity", "requirements": ["PRIV-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:223 processGDPR"], "captures": "{signal, enforced, tcf2_config summary}."},
    {"id": "hooks.processed_auction", "order": 13, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:252 ExecuteProcessedAuctionStage"], "captures": "Request after the processed-auction hook stage."},
    {"id": "auction.setup", "order": 14, "domain": "auction_lifecycle", "requirements": ["AUCT-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:315 HoldAuction setup"], "captures": "{cache_instructions, targeting_data, debug{response,account,override}, conversions_source, resolved_request}."},
    {"id": "floors.enrich", "order": 15, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:295 floors.EnrichWithPriceFloors"], "captures": "{request_after, errors}."},
    {"id": "fpd.resolved", "order": 16, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:325 firstpartydata.ExtractFPDForBidders"], "captures": "Resolved per-bidder first-party data and errors."},
    {"id": "privacy.labels", "order": 17, "domain": "policy_privacy_identity", "requirements": ["PRIV-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/utils.go:107-151 cleanOpenRTBRequests (GPP parse, CCPA, LMT/COPPA, GDPR permissions)"], "captures": "metrics.PrivacyLabels and the request-level privacy signals."},
    {"id": "privacy.bidder", "order": 18, "domain": "policy_privacy_identity", "requirements": ["PRIV-01"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/utils.go:191 AuctionActivitiesAllowed", "exchange/utils.go:212 applyPrivacy", "exchange/utils.go:232 ConvertDownTo25"], "captures": "{core, alias, gdpr{allow_bid_request,pass_geo,pass_id}, activities{fetch_bids,transmit_ufpd,transmit_precise_geo,transmit_tids}, ccpa_enforced, lmt, coppa, blocked, gpp_downgraded, down_converted}."},
    {"id": "bidder.request", "order": 19, "domain": "bidders_adapters", "requirements": ["BIDD-01", "AUCT-01"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:363 cleanOpenRTBRequests result (snapshot after utils.go:239 RebuildRequest)"], "captures": "Per-bidder BidRequest plus is_alias and stored_bid_responses."},
    {"id": "hooks.bidder_request", "order": 20, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:182 ExecuteBidderRequestStage"], "captures": "Bidder request after the bidder-request hook stage."},
    {"id": "adapter.requests", "order": 21, "domain": "bidders_adapters", "requirements": ["BIDD-01"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:210 Bidder.MakeRequests"], "captures": "MakeRequests output (pre-header-injection) and errors."},
    {"id": "adapter.requests_final", "order": 22, "domain": "bidders_adapters", "requirements": ["BIDD-01"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:215-247 after X-Prebid :228, Sec-GPC :230, ads.cert :234, tmax"], "captures": "Request data as handed to doRequest."},
    {"id": "http.out", "order": 23, "domain": "bidders_adapters", "requirements": ["BIDD-01", "CACH-01"], "keyed_by": "_", "trace_field": "http_out", "endpoints": ["*"], "go_capture": ["parity/transport (every wrapped client)", "oracle wire capture"], "captures": "Outbound calls (see OutboundCall)."},
    {"id": "adapter.bids", "order": 24, "domain": "bidders_adapters", "requirements": ["BIDD-01"], "keyed_by": "bidder#call", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:313 Bidder.MakeBids"], "captures": "{bidder_response, errors}."},
    {"id": "hooks.raw_bidder_response", "order": 25, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "bidder#call", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:317 ExecuteRawBidderResponseStage"], "captures": "Bidder response after the raw-bidder-response hook stage."},
    {"id": "bids.adjusted", "order": 26, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "seat", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/bidder.go:324-453 currency conversion and bid adjustments"], "captures": "Per bid {bid_id, imp_id, original_cpm, original_cur, factor, conversion_rate, rule_adjusted_price, currency_after, alt_code_valid}."},
    {"id": "bidder.result", "order": 27, "domain": "auction_lifecycle", "requirements": ["AUCT-01", "AUCT-02"], "keyed_by": "bidder", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:792-867 getAllBids per-bidder result (response time excluded)"], "captures": "{seat_bids, errors, warnings, nonbids}."},
    {"id": "floors.enforce", "order": 28, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:446 floors.Enforce"], "captures": "{enforced, rejected[{seat,bid_id,imp_id,price,floor,floor_cur,reason}]}."},
    {"id": "category.mapping", "order": 29, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:467 applyCategoryMapping"], "captures": "Bid categories, rejections and errors."},
    {"id": "events.tracking", "order": 30, "domain": "cache_support_flows", "requirements": ["ENDP-05", "CACH-02"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:491 getEventTracking / generated bid ids :479-488"], "captures": "Event tracking settings and generated bid IDs."},
    {"id": "hooks.all_processed_bid_responses", "order": 31, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:497 ExecuteAllProcessedBidResponsesStage"], "captures": "Seat bids after the all-processed-bid-responses hook stage."},
    {"id": "auction.winners", "order": 32, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:506-508 newAuction, validateAndUpdateMultiBid, setRoundedPrices"], "captures": "Winning, multibid and rounded prices per imp."},
    {"id": "cache.result", "order": 33, "domain": "cache_support_flows", "requirements": ["CACH-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:528 auction.doCache", "exchange/auction.go:204,309 doCache"], "captures": "{values_sent, uuids, errors}."},
    {"id": "targeting", "order": 34, "domain": "policy_privacy_identity", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:542 targeting per imp per seat", "exchange/exchange.go:586 adservertargeting"], "captures": "Targeting key/values per imp per seat."},
    {"id": "seat_non_bids", "order": 35, "domain": "auction_lifecycle", "requirements": ["AUCT-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:592 setSeatNonBid", "endpoints/openrtb2/auction.go:305 setSeatNonBidRaw"], "captures": "Seat non-bids."},
    {"id": "exchange.response", "order": 36, "domain": "auction_lifecycle", "requirements": ["AUCT-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["exchange/exchange.go:597 HoldAuction return (BidResponse + ExtBidResponse)"], "captures": "BidResponse and ExtBidResponse returned by HoldAuction."},
    {"id": "video.pods", "order": 37, "domain": "endpoints", "requirements": ["ENDP-03"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/video"], "go_capture": ["endpoints/openrtb2/video_auction.go:371 buildVideoResponse"], "captures": "Video pods and pod errors."},
    {"id": "video.cache", "order": 38, "domain": "cache_support_flows", "requirements": ["CACH-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/video"], "go_capture": ["endpoints/openrtb2/video_auction.go video cache handling"], "captures": "Video cache inputs and results."},
    {"id": "amp.targeting_response", "order": 39, "domain": "endpoints", "requirements": ["ENDP-02"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/amp"], "go_capture": ["endpoints/openrtb2/amp_auction.go:353-390 targeting extraction"], "captures": "AMP targeting response before encoding."},
    {"id": "hooks.auction_response", "order": 40, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:369 ExecuteAuctionResponseStage"], "captures": "Response after the auction-response hook stage."},
    {"id": "hooks.exitpoint", "order": 41, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:397 ExecuteExitpointStage"], "captures": "Final response object after the exitpoint hook stage."},
    {"id": "hook_outcomes", "order": 42, "domain": "hooks_modules", "requirements": ["MODL-01"], "keyed_by": "_", "trace_field": "stages", "endpoints": ["/openrtb2/auction", "/openrtb2/amp", "/openrtb2/video"], "go_capture": ["endpoints/openrtb2/auction.go:369-397 hookExecutor.GetOutcomes"], "captures": "hookexecution.StageOutcome list."},
    {"id": "analytics", "order": 43, "domain": "cutover_proof", "requirements": ["OPER-01"], "keyed_by": "_", "trace_field": "analytics", "endpoints": ["*"], "go_capture": ["parity/wiring/analytics.go analytics runner wrapper (router/router.go analyticsBuild.New)"], "captures": "Projections of every Log*Object call."},
    {"id": "metrics_delta", "order": 44, "domain": "cutover_proof", "requirements": ["OPER-01"], "keyed_by": "_", "trace_field": "metrics_delta", "endpoints": ["*"], "go_capture": ["parity/server exec handler: Prometheus Gather before/after (metrics/prometheus/prometheus.go Gatherer)"], "captures": "Changed Prometheus series."},
    {"id": "http.response", "order": 45, "domain": "endpoints", "requirements": ["ENDP-01", "ENDP-02", "ENDP-03", "ENDP-04", "ENDP-05", "ENDP-06"], "keyed_by": "_", "trace_field": "http_response", "endpoints": ["*"], "go_capture": ["parity/server exec recorder", "endpoints/openrtb2/auction.go:391-403 encoder SetEscapeHTML(false) + trailing newline"], "captures": "Status, headers and exact body bytes."}
  ]
}
