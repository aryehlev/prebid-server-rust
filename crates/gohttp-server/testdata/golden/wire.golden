case plain panic
server plain
wait 300
send "GET /t/panic/flush HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Type: text/plain; charset=utf-8\r\nTransfer-Encoding: chunked\r\n\r\n7\r\nflushed\r\n"
