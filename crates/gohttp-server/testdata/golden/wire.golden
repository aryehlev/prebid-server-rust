send "GET /version HTTP/1.1\r\n\r\n"
response "HTTP/1.1 400 Bad Request: missing required Host header\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n400 Bad Request: missing required Host header"
end eof

case admin 1.0
server admin
wait 300
send "GET /version HTTP/1.0\r\n\r\n"
response "HTTP/1.0 200 OK\r\nDate: <date>\r\nContent-Length: 42\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n{\"revision\":\"not-set\",\"version\":\"not-set\"}"
end eof

case admin pipeline
server admin
wait 300
send "GET /version HTTP/1.1\r\nHost: example.com\r\n\r\nGET /debug/pprof HTTP/1.1\r\nHost: example.com\r\n\r\nGET /nope HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 42\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n{\"revision\":\"not-set\",\"version\":\"not-set\"}HTTP/1.1 307 Temporary Redirect\r\nContent-Type: text/html; charset=utf-8\r\nLocation: /debug/pprof/\r\nDate: <date>\r\nContent-Length: 49\r\n\r\n<a href=\"/debug/pprof/\">Temporary Redirect</a>.\n\nHTTP/1.1 404 Not Found\r\nContent-Type: text/plain; charset=utf-8\r\nX-Content-Type-Options: nosniff\r\nDate: <date>\r\nContent-Length: 19\r\n\r\n404 page not found\n"
end open

case admin post body
server admin
wait 300
send "POST /currency/rates HTTP/1.1\r\nHost: example.com\r\nContent-Length: 3\r\n\r\nabc"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 21\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nrates /currency/rates"
end open

case admin asterisk 1.0
server admin
wait 300
send "GET * HTTP/1.0\r\n\r\n"
response "HTTP/1.0 400 Bad Request\r\nDate: <date>\r\nContent-Length: 0\r\n\r\n"
end eof

case short stall headers
server short
wait 1000
send "GET /status HTTP/1.1\r\nHost: x\r\n"
response ""
end eof

case short stall nothing
server short
wait 1000
response ""
end eof

case short idle close
server short
wait 1000
send "GET /status HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 204 No Content\r\nDate: <date>\r\n\r\n"
end eof

case short slow body
server short
wait 1500
send "POST /t/slowbody HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nhello"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 16\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nn=5 timeout=true"
end eof

case short slow chunked body
server short
wait 1500
send "POST /t/slowbody HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 16\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nn=5 timeout=true"
end eof

case short paused body
server short
wait 1000
send "POST /t/slowbody HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n"
pause 100
send "hello"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 17\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nn=5 timeout=false"
end eof

case short sleep under
server short
wait 1000
send "GET /t/sleep/100 HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nDate: <date>\r\nContent-Length: 4\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nlate"
end eof

case short sleep over
server short
wait 2500
send "GET /t/sleep/1300 HTTP/1.1\r\nHost: example.com\r\n\r\n"
response ""
end eof

case short keepalive then idle
server short
wait 1000
send "GET /status HTTP/1.1\r\nHost: example.com\r\n\r\n"
pause 100
send "GET /status HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 204 No Content\r\nDate: <date>\r\n\r\nHTTP/1.1 204 No Content\r\nDate: <date>\r\n\r\n"
end eof

case unix status
server unix
wait 300
send "GET /status HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 204 No Content\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\n\r\n"
end open

case unix remote
server unix
wait 300
send "GET /t/remote HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 9\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nremote=\"\""
end open

case unix echo
server unix
wait 300
send "POST /openrtb2/auction HTTP/1.1\r\nHost: example.com\r\nContent-Length: 3\r\n\r\nabc"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nContent-Type: application/json\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 26\r\n\r\nlen=3 body=\"abc\" trailer:\n"
end open

case unix pipeline
server unix
wait 300
send "GET /version HTTP/1.1\r\nHost: example.com\r\n\r\nGET /t/write/3000 HTTP/1.1\r\nHost: example.com\r\n\r\nGET /static/a.txt HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 42\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n{\"revision\":\"not-set\",\"version\":\"not-set\"}HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Type: text/plain; charset=utf-8\r\nTransfer-Encoding: chunked\r\n\r\nbb8\r\\r\n0\r\n\r\nHTTP/1.1 200 OK\r\nAccept-Ranges: bytes\r\nCache-Control: no-cache, no-store, must-revalidate\r\nContent-Length: 14\r\nContent-Type: text/plain; charset=utf-8\r\nExpires: 0\r\nLast-Modified: Thu, 02 Jan 2020 03:04:05 GMT\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\n\r\nhello, static\n"
end open

case unix bad request
server unix
wait 300
send "GET /status HTTP/1.1\r\n\r\n"
response "HTTP/1.1 400 Bad Request: missing required Host header\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n400 Bad Request: missing required Host header"
end eof

case plain header too large
server plain
wait 300
send "GET /status HTTP/1.1\r\nHost: x\r\nX-Big: "
send "a" * 1100000
send "\r\n\r\n"
response "HTTP/1.1 431 Request Header Fields Too Large\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n431 Request Header Fields Too Large"
end eof

case plain body max
server plain
wait 300
send "POST /t/body/max HTTP/1.1\r\nHost: example.com\r\nContent-Length: 20\r\n\r\nmmmmmmmmmmmmmmmmmmmmGET /status HTTP/1.1\r\nHost: example.com\r\n\r\n"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nConnection: close\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 37\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nn=16 err=http: request body too large"
end eof

case plain body none huge
server plain
wait 300
send "POST /t/body/none HTTP/1.1\r\nHost: x\r\nContent-Length: 300000\r\n\r\n"
send "h" * 300000
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nok"
end eof

case plain expect 100 noread
server plain
wait 300
send "POST /t/body/none HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\nhello"
response "HTTP/1.1 200 OK\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nok"
end eof

