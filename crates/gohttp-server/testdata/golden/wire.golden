server plain
wait 300
send "GET /status HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"
response "HTTP/1.1 204 No Content\r\nCache-Control: no-cache, no-store, must-revalidate\r\nExpires: 0\r\nPragma: no-cache\r\nVary: Origin\r\nDate: <date>\r\nConnection: close\r\n\r\n"
end eof

case plain bad request
server plain
wait 300
send "GET /status HTTP/1.1\r\n\r\n"
response "HTTP/1.1 400 Bad Request: missing required Host header\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\n400 Bad Request: missing required Host header"
