{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "enableAllProjectMcpServers": false,
  "env": {
    "CARGO_NET_OFFLINE": "true",
    "CARGO_TERM_COLOR": "never",
    "GOPROXY": "off",
    "GOFLAGS": "-mod=readonly",
    "GOTOOLCHAIN": "local",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "NotebookEdit",
      "Bash(git -c:*)",
      "Bash(git -C:*)",
      "Bash(git commit:*)",
      "Bash(git commit-tree:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clean:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git branch:*)",
      "Bash(git update-ref:*)",
      "Bash(git replace:*)",
      "Bash(git notes:*)",
      "Bash(git worktree:*)",
      "Bash(git filter-branch:*)",
      "Bash(git gc:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(cargo update:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo login:*)",
      "Bash(cargo owner:*)",
      "Bash(cargo yank:*)",
      "Bash(go get:*)",
      "Bash(go mod:*)",
      "Bash(go install:*)",
      "Bash(go generate:*)",
      "Bash(go work:*)",
      "Edit(./.github/**)",
      "Edit(./.planning/**)",
      "Edit(./.claude/**)",
      "Edit(./.omx/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./rust/.cargo/**)",
      "Edit(./rust/Cargo.toml)",
      "Edit(./rust/rust-toolchain.toml)",
      "Edit(./rust/rustfmt.toml)",
      "Edit(./rust/deny.toml)",
      "Edit(./rust/taplo.toml)",
      "Edit(./rust/PORTING.md)",
      "Edit(./rust/README.md)",
      "Edit(./rust/UPSTREAM_SYNC)",
      "Edit(./rust/upstream-port-log.jsonl)",
      "Edit(./rust/conformance/README.md)",
      "Edit(./rust/scripts/**)",
      "Edit(./rust/legacy/**)"
    ]
  }
}
