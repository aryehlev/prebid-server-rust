{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "enableAllProjectMcpServers": false,
  "env": {
    "CARGO_NET_OFFLINE": "true",
    "CARGO_TERM_COLOR": "never",
    "GOPROXY": "off",
    "GOFLAGS": "-mod=readonly",
    "GOTOOLCHAIN": "local",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "NotebookEdit",
      "Bash(git -c:*)",
      "Bash(git -C:*)",
      "Bash(git commit:*)",
      "Bash(git commit-tree:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clean:*)",
      "Bash(git am:*)",
      "Bash(git apply:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git branch:*)",
      "Bash(git update-ref:*)",
      "Bash(git replace:*)",
      "Bash(git notes:*)",
      "Bash(git worktree:*)",
      "Bash(git filter-branch:*)",
      "Bash(git gc:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)",
      "Bash(cargo update:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo login:*)",
      "Bash(cargo owner:*)",
      "Bash(cargo yank:*)",
      "Bash(go get:*)",
      "Bash(go mod:*)",
      "Bash(go install:*)",
      "Bash(go generate:*)",
      "Bash(go work:*)",
      "Edit(./.github/**)",
      "Edit(./.planning/**)",
      "Edit(./.claude/**)",
      "Edit(./.omx/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.upstream/**)",
      "Edit(./.gitignore)",
      "Edit(./.gitmodules)",
      "Edit(./.cargo/**)",
      "Edit(./Cargo.toml)",
      "Edit(./rust-toolchain.toml)",
      "Edit(./rust-toolchain)",
      "Edit(./rustfmt.toml)",
      "Edit(./.rustfmt.toml)",
      "Edit(./clippy.toml)",
      "Edit(./.clippy.toml)",
      "Edit(./deny.toml)",
      "Edit(./taplo.toml)",
      "Edit(./patches/**)",
      "Edit(./scripts/**)",
      "Edit(./PORTING.md)",
      "Edit(./README.md)",
      "Edit(./LICENSE)",
      "Edit(./LICENSES/**)",
      "Edit(./NOTICE)",
      "Edit(./UPSTREAM_SYNC)",
      "Edit(./upstream-port-log.jsonl)",
      "Edit(./conformance/README.md)",
      "Edit(./**/.cargo/**)",
      "Edit(./**/rust-toolchain)",
      "Edit(./**/rust-toolchain.toml)",
      "Edit(./**/rustfmt.toml)",
      "Edit(./**/.rustfmt.toml)",
      "Edit(./**/clippy.toml)",
      "Edit(./**/.clippy.toml)",
      "Edit(./**/go.work)",
      "Edit(./**/go.work.sum)",
      "Edit(./**/vendor/**)"
    ]
  }
}
