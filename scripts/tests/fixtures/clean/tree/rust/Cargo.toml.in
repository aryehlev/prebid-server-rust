[workspace]
resolver = "3"
members = ["crates/good"]

[workspace.package]
version = "0.1.0"
edition = "2024"

[workspace.lints.rust]
unsafe_code = "forbid"
missing_docs = "warn"
unused = { level = "deny", priority = -1 }

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
allow_attributes = "warn"
allow_attributes_without_reason = "deny"
expect_used = "warn"

[workspace.metadata.cargo-machete]
ignored = []
