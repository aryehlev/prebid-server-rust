#!/usr/bin/env bash
# A script that uses only allowed forms.
set -euo pipefail
# shellcheck source=lib.sh
source "lib.sh"
shellcheck --enable=all --severity=style --external-sources x.sh
cargo test --workspace --locked --all-targets
cargo publish --allow-dirty --dry-run
cargo deny --locked check --deny warnings
git add -A -- rust
grep -A 3 pattern file.txt
export CARGO_BUILD_WARNINGS=deny
taplo fmt --check --config taplo.toml
cargo fmt --all -- --check && taplo fmt --config taplo.toml
printf '%s\n' "${CARGO_HOME:-${HOME}/.cargo}/bin"
export PBS_RUSTC_NOTE=fine RUSTDOC_NOTES=fine
