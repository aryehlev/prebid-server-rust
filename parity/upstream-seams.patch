+func TestBuildParityBidder(t *testing.T) {
+	appnexusInfo := config.BidderInfo{Endpoint: "http://ib.adnxs.com/openrtb2"}
+	tests := []struct {
+		name          string
+		bidder        openrtb_ext.BidderName
+		info          config.BidderInfo
+		wrapInfoAware bool
+		wantInfoAware bool
+		wantErr       string
+	}{
+		{name: "raw", bidder: openrtb_ext.BidderAppnexus, info: appnexusInfo},
+		{name: "info aware", bidder: openrtb_ext.BidderAppnexus, info: appnexusInfo, wrapInfoAware: true, wantInfoAware: true},
+		{name: "alias uses parent builder", bidder: "myappnexus", info: config.BidderInfo{AliasOf: "appnexus", Endpoint: "http://ib.adnxs.com/openrtb2"}},
+		{name: "alias of unknown parent", bidder: "myalias", info: config.BidderInfo{AliasOf: "nope"}, wantErr: "myalias"},
+		{name: "unknown bidder", bidder: "nope", info: config.BidderInfo{}, wantErr: "builder not registered"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			bidder, err := BuildParityBidder(tt.bidder, ParityAdapterConfig(tt.info), config.Server{}, tt.info, tt.wrapInfoAware)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			_, isInfoAware := bidder.(*adapters.InfoAwareBidder)
+			assert.Equal(t, tt.wantInfoAware, isInfoAware)
+		})
+	}
+}
