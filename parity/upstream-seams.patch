+)
+
+// TestParityCookieDeprecationClock: in parity mode the receive-cookie-deprecation
+// cookie expires TTLSec after the fake clock.
+func TestParityCookieDeprecationClock(t *testing.T) {
+	fakes.Uninstall()
+	src := fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+
+	endpoint := NewCookieSyncEndpoint(
+		map[string]usersync.Syncer{"a": &MockSyncer{}},
+		&config.Configuration{},
+		fakePermissionsBuilder{permissions: &fakePermissions{}}.Builder,
+		fakeTCF2ConfigBuilder{cfg: gdpr.NewTCF2Config(config.TCF2{}, config.AccountGDPR{})}.Builder,
+		&metrics.MetricsEngineMock{},
+		&MockAnalyticsRunner{},
+		&FakeAccountsFetcher{},
+		map[string]openrtb_ext.BidderName{},
+	).(*cookieSyncEndpoint)
+
+	account := &config.Account{}
+	account.Privacy.PrivacySandbox.CookieDeprecation = config.CookieDeprecation{Enabled: true, TTLSec: 86400}
+	w := httptest.NewRecorder()
+	endpoint.setCookieDeprecationHeader(w, httptest.NewRequest(http.MethodPost, "/cookie_sync", nil), account)
+
+	want := "receive-cookie-deprecation=1; Path=/; Expires=" + src.Now().Add(24*time.Hour).Format(http.TimeFormat) +
+		"; HttpOnly; Secure; SameSite=None; Partitioned;"
+	assert.Equal(t, want, w.Header().Get("Set-Cookie"))
+}
