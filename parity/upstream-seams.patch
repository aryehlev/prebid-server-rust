+		assert.Equal(t, 2.0, *bid.Factor)
+		require.NotNil(t, bid.RuleAdjustedPrice)
+		assert.Equal(t, bid.OriginalCPM*2, *bid.RuleAdjustedPrice)
+	}
+	_, ok := tr.Stages[parity.StageHooksBidderRequest]["appnexus"]
+	assert.True(t, ok, "hooks.bidder_request recorded")
