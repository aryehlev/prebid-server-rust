+			}
+		}
+	}
+	if seats, ok := doc["seatbid"].([]any); ok {
+		sort.Slice(seats, func(i, j int) bool { return seatName(seats[i]) < seatName(seats[j]) })
+	}
+	raw, err := json.Marshal(doc)
+	require.NoError(t, err)
+	return string(raw)
+}
+
+func seatName(seatBid any) string {
+	if m, ok := seatBid.(map[string]any); ok {
+		if seat, ok := m["seat"].(string); ok {
+			return seat
+		}
+	}
+	return ""
+}
