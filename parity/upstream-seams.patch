+// TestParityAuctionStages runs auction sample requests with and without a
+// parity session: the response and the request the exchange receives are
+// identical (no observer effect), every auction endpoint stage is captured,
+// and request.validated is exactly the request Go hands to the exchange.
+func TestParityAuctionStages(t *testing.T) {
+	files := []string{
+		"sample-requests/valid-whole/exemplary/simple.json",
+		"sample-requests/valid-whole/exemplary/ortb-2.5-to-2.6-upconvert.json",
+		"sample-requests/valid-whole/exemplary/ortb-2.6-to-2.5-downconvert.json",
+		"sample-requests/valid-whole/exemplary/interstitial-no-size.json",
+		"sample-requests/valid-whole/exemplary/source-schain.json",
+		"sample-requests/valid-whole/exemplary/dooh.json",
+		"sample-requests/valid-whole/exemplary/device-sua.json",
+	}
+	for _, file := range files {
+		t.Run(filepath.Base(file), func(t *testing.T) {
+			fileData, test := loadFixture(t, file)
+			off := runAuctionFixture(t, file, false)
+			on := runAuctionFixture(t, file, true)
+
+			assert.Equal(t, off.validated, on.validated, "validated request changed under tracing")
+			assertSameResponse(t, off.body, on.body)
+			assertFixtureResponse(t, test, fileData, file)
+			assertStages(t, on.trace, auctionStages)
+			assert.Equal(t, on.validated, stageJSON(t, on.trace, parity.StageRequestValidated))
+			if test.ExpectedValidatedBidReq != nil {
+				assert.JSONEq(t, string(test.ExpectedValidatedBidReq), stageJSON(t, on.trace, parity.StageRequestValidated))
+			}
+			assert.JSONEq(t, string(test.BidRequest), stageJSON(t, on.trace, parity.StageHooksEntrypoint))
+		})
+	}
+}
