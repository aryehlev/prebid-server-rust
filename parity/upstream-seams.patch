diff --git a/config/parity.go b/config/parity.go
new file mode 100644
index 0000000000000000000000000000000000000000..7395d41bd5a63a12cdf1d2f44ba63906cfe3793d
--- /dev/null
+++ b/config/parity.go
@@ -0,0 +1,76 @@
+package config
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"strings"
+)
+
+// ParityMinTokenLength is the minimum length of parity.token.
+const ParityMinTokenLength = 16
+
+// ParityConfig configures the branch-only Go-vs-Rust differential parity
+// harness (see parity/README.md). It is disabled by default and must never be
+// enabled on a production host: when enabled the server exposes its full
+// configuration and an arbitrary request-dispatch endpoint under /__parity/*,
+// routes every outbound call to the parity oracle and injects deterministic
+// fakes into adapters that use wall-clock time or randomness.
+type ParityConfig struct {
+	// Enabled turns parity mode on.
+	Enabled bool `mapstructure:"enabled"`
+	// Token is the shared secret every /__parity/* request must send in the
+	// X-Parity-Token header. Required when Enabled.
+	Token string `mapstructure:"token" log:"redact"`
+	// OracleURL is the parity oracle's forward-proxy address, for example
+	// http://127.0.0.1:7999. Without it only inline-mocked cases can make
+	// outbound calls; everything else fails with "parity: network disabled".
+	OracleURL string `mapstructure:"oracle_url"`
+	// AllowNonLoopback lifts the loopback-only restriction on host, oracle_url
+	// and /__parity/* callers.
+	AllowNonLoopback bool `mapstructure:"allow_non_loopback"`
+}
+
+// validate enforces the parity startup guards. It reports nothing when parity
+// is disabled, so a disabled harness never changes startup behaviour.
+func (cfg *ParityConfig) validate(host string, errs []error) []error {
+	if !cfg.Enabled {
+		return errs
+	}
+	if len(cfg.Token) < ParityMinTokenLength {
+		errs = append(errs, fmt.Errorf("parity.token must be at least %d characters when parity.enabled is true", ParityMinTokenLength))
+	}
+	if !cfg.AllowNonLoopback && !IsLoopbackHost(host) {
+		errs = append(errs, fmt.Errorf("parity.enabled requires host to be a loopback address, got %q (set parity.allow_non_loopback to override)", host))
+	}
+	return cfg.validateOracleURL(errs)
+}
+
+func (cfg *ParityConfig) validateOracleURL(errs []error) []error {
+	if cfg.OracleURL == "" {
+		return errs
+	}
+	u, err := url.Parse(cfg.OracleURL)
+	if err != nil {
+		return append(errs, fmt.Errorf("parity.oracle_url is invalid: %v", err))
+	}
+	if u.Scheme != "http" || u.Hostname() == "" {
+		return append(errs, fmt.Errorf("parity.oracle_url must be an absolute http URL, got %q", cfg.OracleURL))
+	}
+	if !cfg.AllowNonLoopback && !IsLoopbackHost(u.Hostname()) {
+		return append(errs, fmt.Errorf("parity.oracle_url must point at a loopback address, got %q (set parity.allow_non_loopback to override)", cfg.OracleURL))
+	}
+	return errs
+}
+
+// IsLoopbackHost reports whether host (a host name or IP literal, optionally
+// bracketed IPv6) names the loopback interface. An empty host means "all
+// interfaces" and is not loopback.
+func IsLoopbackHost(host string) bool {
+	host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+	if strings.EqualFold(host, "localhost") {
+		return true
+	}
+	ip := net.ParseIP(host)
+	return ip != nil && ip.IsLoopback()
+}
