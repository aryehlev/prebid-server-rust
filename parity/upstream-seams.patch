+// parity session, so sample-request expectations hold with tracing enabled.
+func assertFixtureResponse(t *testing.T, test testCase, fileData []byte, file string) {
+	t.Helper()
+	cfg := &config.Configuration{MaxRequestSize: maxSize}
+	if test.Config != nil {
+		cfg.BlockedApps = test.Config.BlockedApps
+		cfg.BlockedAppsLookup = test.Config.getBlockedAppLookup()
+		cfg.AccountRequired = test.Config.AccountRequired
+		cfg.AccountDefaults.PreferredMediaType = test.Config.PreferredMediaType
+	}
+	cfg.MarshalAccountDefaults()
+	test.endpointType = OPENRTB_ENDPOINT
+	handler, _, bidServers, currencyServer, err := buildTestEndpoint(test, cfg)
+	require.NoError(t, err)
+	defer closeServers(bidServers, currencyServer)
+
+	_, end := trace.Begin(&parity.Envelope{CaseID: file})
+	defer end()
+	runEndToEndTest(t, handler, test, fileData, file)
+}
