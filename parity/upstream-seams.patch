+package exchange
+
+import (
+	"context"
+	"sort"
+	"sync"
+
+	"github.com/prebid/prebid-server/v4/openrtb_ext"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+)
+
+// Parity mode only: the bidders of one auction build their requests one at a
+// time, in bidder name order.
+//
+// The per-bidder requests share objects with each other and with the auction
+// request: cleanOpenRTBRequests copies the request shallowly, so bidders whose
+// site, app or user was not rewritten share the same pointers. Some adapters
+// write through them while building their requests: gumgum copies Site but
+// not its Publisher before setting the publisher ID from its imp params
+// (adapters/gumgum/gumgum.go:45-46). Whether another bidder's bidder-request
+// hook stage and MakeRequests see the original value or gumgum's then depends
+// on how Go schedules the bidder goroutines of getAllBids, and two Go processes
+// send different requests for the same case. Running each bidder's request
+// phase (bidder-request hooks through MakeRequests) after the phases of the
+// bidders before it in name order is one of the schedules Go can take, so
+// every value it produces is a Go value, and the same one on every run.
+
+// parityTurnsKey is the context key of the turns of one getAllBids call.
+type parityTurnsKey struct{}
+
+// parityTurn is one bidder's turn to build its requests.
+type parityTurn struct {
+	ready chan struct{}
+	once  sync.Once
+	next  *parityTurn
+}
+
+// end ends the turn and starts the next bidder's; calls after the first do
+// nothing. A nil turn does nothing.
+func (t *parityTurn) end() {
+	if t == nil {
+		return
+	}
+	t.once.Do(func() {
+		if t.next != nil {
+			close(t.next.ready)
+		}
+	})
+}
+
+// parityTurns returns ctx carrying one turn per bidder request, chained in
+// bidder name order, the first one started. Without a parity case in flight,
+// with fewer than two bidders, or when two requests share a bidder name, it
+// returns ctx unchanged and the bidders run as in production.
+func parityTurns(ctx context.Context, bidderRequests []BidderRequest) context.Context {
+	if trace.Current() == nil || len(bidderRequests) < 2 {
+		return ctx
+	}
+	turns := make(map[openrtb_ext.BidderName]*parityTurn, len(bidderRequests))
+	names := make([]string, 0, len(bidderRequests))
+	for _, br := range bidderRequests {
+		if _, dup := turns[br.BidderName]; dup {
+			return ctx
+		}
+		turns[br.BidderName] = &parityTurn{ready: make(chan struct{})}
+		names = append(names, string(br.BidderName))
+	}
+	sort.Strings(names)
+	for i := 0; i+1 < len(names); i++ {
+		turns[openrtb_ext.BidderName(names[i])].next = turns[openrtb_ext.BidderName(names[i+1])]
+	}
+	close(turns[openrtb_ext.BidderName(names[0])].ready)
+	return context.WithValue(ctx, parityTurnsKey{}, turns)
+}
+
+// parityTurnOf returns bidder's turn in ctx, or nil.
+func parityTurnOf(ctx context.Context, bidder openrtb_ext.BidderName) *parityTurn {
+	turns, _ := ctx.Value(parityTurnsKey{}).(map[openrtb_ext.BidderName]*parityTurn)
+	return turns[bidder]
+}
+
+// parityTakeTurn waits until bidder's turn starts and returns the function
+// that ends it. requestBid ends the turn once MakeRequests returned
+// (parityBidderTrace.adapterRequests); the bidder goroutine defers the
+// returned function, so a turn also ends when requestBid returns earlier or
+// panics. It stops waiting when ctx is done, so a bidder is never held past
+// the auction deadline. Without turns it returns at once.
+func parityTakeTurn(ctx context.Context, bidder openrtb_ext.BidderName) func() {
+	t := parityTurnOf(ctx, bidder)
+	if t == nil {
+		return func() {}
+	}
+	select {
+	case <-t.ready:
+	case <-ctx.Done():
+	}
+	return t.end
+}
