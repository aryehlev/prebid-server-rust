@@ -0,0 +1,888 @@
+package exchange
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/prebid/openrtb/v20/openrtb2"
+	"github.com/prebid/prebid-server/v4/adapters"
+	"github.com/prebid/prebid-server/v4/config"
+	"github.com/prebid/prebid-server/v4/errortypes"
+	"github.com/prebid/prebid-server/v4/exchange/entities"
+	"github.com/prebid/prebid-server/v4/firstpartydata"
+	"github.com/prebid/prebid-server/v4/gdpr"
+	"github.com/prebid/prebid-server/v4/hooks/hookexecution"
+	"github.com/prebid/prebid-server/v4/metrics"
+	"github.com/prebid/prebid-server/v4/openrtb_ext"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/stagedata"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+	"github.com/prebid/prebid-server/v4/prebid_cache_client"
+	"github.com/prebid/prebid-server/v4/privacy"
+)
+
+// This file holds the exchange's parity stage recorders (branch only). The hook
+// lines in exchange.go and auction.go call them only when a parity case is in
+// flight (trace.Current() != nil), so production behaviour and cost are
+// unchanged. Every recorder only reads state the exchange has already built and
+// never rebuilds or mutates it (observer-effect rule, parity/README.md). Payload
+// shapes are defined in parity/stagedata.
+
+// errorList turns an optional error into the list Session.Errors records, so
+// "no error" is recorded as an explicit empty list.
+func errorList(err error) []error {
+	if err == nil {
+		return nil
+	}
+	return []error{err}
+}
+
+// recordStage records a stage whose Go site has no error list of its own, with
+// explicit empty error and warning lists.
+func recordStage(s *trace.Session, stage parity.StageID, key string, v any) {
+	s.Record(stage, key, v)
+	s.Errors(stage, key, nil)
+}
+
+// rejectList is errorList for the typed hook-stage reject (a nil
+// *RejectError must not become a non-nil error interface).
+func rejectList(reject *hookexecution.RejectError) []error {
+	if reject == nil {
+		return nil
+	}
+	return []error{reject}
+}
+
+// recordProcessedAuction records hooks.processed_auction.
+func recordProcessedAuction(s *trace.Session, err error) {
+	_, rejected := hookexecution.CastRejectErr(err)
+	s.Record(parity.StageHooksProcessedAuction, "", stagedata.HookStage{Rejected: rejected})
+	s.Errors(parity.StageHooksProcessedAuction, "", errorList(err))
+}
+
+// recordFloorsEnrichErrors attaches EnrichWithPriceFloors' errors to
+// floors.enrich (the payload itself is recorded inside the floors package).
+func recordFloorsEnrichErrors(s *trace.Session, errs []error) {
+	s.Errors(parity.StageFloorsEnrich, "", errs)
+}
+
+// auctionSetupTrace carries the HoldAuction locals that auction.setup records.
+type auctionSetupTrace struct {
+	cache            extCacheInstructions
+	targeting        *targetData
+	warnings         []*errortypes.Warning
+	prebid           *openrtb_ext.ExtRequestPrebid
+	responseDebug    bool
+	accountDebug     bool
+	debugLog         *DebugLog
+	resolvedRequest  json.RawMessage
+	hasRateConverter bool
+}
+
+// recordAuctionSetup records auction.setup.
+func recordAuctionSetup(s *trace.Session, in auctionSetupTrace) {
+	if !s.Wants(parity.StageAuctionSetup) {
+		return
+	}
+	setup := stagedata.AuctionSetup{
+		CacheInstructions: stagedata.CacheInstructions{
+			CacheBids:      in.cache.cacheBids,
+			CacheVAST:      in.cache.cacheVAST,
+			ReturnCreative: in.cache.returnCreative,
+		},
+		TargetingData: targetingDataOf(in.targeting),
+		Debug: stagedata.DebugFlags{
+			ResponseDebugAllowed: in.responseDebug,
+			AccountDebugAllowed:  in.accountDebug,
+		},
+		ResolvedRequest: in.resolvedRequest,
+	}
+	if in.debugLog != nil {
+		setup.Debug.DebugOverride = in.debugLog.DebugOverride
+		setup.Debug.DebugEnabledOrOverridden = in.debugLog.DebugEnabledOrOverridden
+	}
+	if in.prebid != nil {
+		setup.Server = in.prebid.Server
+		setup.CurrencyConversions = in.prebid.CurrencyConversions
+	}
+	setup.ConversionsSource = conversionsSource(in.hasRateConverter, setup.CurrencyConversions)
+	s.Record(parity.StageAuctionSetup, "", setup)
+	warnings := make([]error, 0, len(in.warnings))
+	for _, w := range in.warnings {
+		warnings = append(warnings, w)
+	}
+	s.Errors(parity.StageAuctionSetup, "", warnings)
+}
+
+func targetingDataOf(td *targetData) *stagedata.TargetingData {
+	if td == nil {
+		return nil
+	}
+	return &stagedata.TargetingData{
+		PriceGranularity:          td.priceGranularity,
+		MediaTypePriceGranularity: td.mediaTypePriceGranularity,
+		IncludeWinners:            td.includeWinners,
+		IncludeBidderKeys:         td.includeBidderKeys,
+		IncludeCacheBids:          td.includeCacheBids,
+		IncludeCacheVAST:          td.includeCacheVast,
+		IncludeFormat:             td.includeFormat,
+		PreferDeals:               td.preferDeals,
+		AlwaysIncludeDeals:        td.alwaysIncludeDeals,
+		CacheHost:                 td.cacheHost,
+		CachePath:                 td.cachePath,
+		Prefix:                    td.prefix,
+	}
+}
+
+// conversionsSource names the branch currency.GetAuctionCurrencyRates takes for
+// the request's ext.prebid.currency (kept in step with that function).
+func conversionsSource(hasRateConverter bool, rates *openrtb_ext.ExtRequestCurrency) string {
+	switch {
+	case rates == nil && !hasRateConverter:
+		return stagedata.ConversionsSourceNone
+	case rates == nil:
+		return stagedata.ConversionsSourcePBS
+	case !hasRateConverter:
+		return stagedata.ConversionsSourceRequest
+	case rates.UsePBSRates != nil && !*rates.UsePBSRates:
+		return stagedata.ConversionsSourceRequest
+	case len(rates.ConversionRates) == 0:
+		return stagedata.ConversionsSourcePBS
+	default:
+		return stagedata.ConversionsSourceAggregate
+	}
+}
+
+// recordFPD records fpd.resolved.
+func recordFPD(s *trace.Session, resolved map[openrtb_ext.BidderName]*firstpartydata.ResolvedFirstPartyData, errs []error) {
+	if !s.Wants(parity.StageFPDResolved) {
+		return
+	}
+	out := stagedata.FPDResolved{Bidders: make(map[string]stagedata.FirstPartyData, len(resolved))}
+	for bidder, fpd := range resolved {
+		if fpd == nil {
+			out.Bidders[string(bidder)] = stagedata.FirstPartyData{}
+			continue
+		}
+		out.Bidders[string(bidder)] = stagedata.FirstPartyData{Site: fpd.Site, App: fpd.App, User: fpd.User, Device: fpd.Device}
+	}
+	s.Record(parity.StageFPDResolved, "", out)
+	s.Errors(parity.StageFPDResolved, "", errs)
+}
+
+// recordRequestSplit records privacy.labels and bidder.request from the result
+// of cleanOpenRTBRequests (each bidder request was rebuilt at utils.go and no
+// bidder goroutine has started yet).
+func recordRequestSplit(s *trace.Session, bidderRequests []BidderRequest, labels metrics.PrivacyLabels, errs []error) {
+	s.Record(parity.StagePrivacyLabels, "", stagedata.PrivacyLabels{
+		CCPAProvided:   labels.CCPAProvided,
+		CCPAEnforced:   labels.CCPAEnforced,
+		COPPAEnforced:  labels.COPPAEnforced,
+		GDPREnforced:   labels.GDPREnforced,
+		GDPRTCFVersion: string(labels.GDPRTCFVersion),
+		LMTEnforced:    labels.LMTEnforced,
+	})
+	s.Errors(parity.StagePrivacyLabels, "", errs)
+	if !s.Wants(parity.StageBidderRequest) {
+		return
+	}
+	for _, br := range bidderRequests {
+		recordStage(s, parity.StageBidderRequest, string(br.BidderName), stagedata.BidderRequest{
+			Bidder:             string(br.BidderName),
+			Core:               string(br.BidderCoreName),
+			IsAlias:            br.IsRequestAlias,
+			Request:            br.BidRequest,
+			StoredBidResponses: br.BidderStoredResponses,
+			ImpReplaceImpID:    br.ImpReplaceImpId,
+		})
+	}
+}
+
+// parityPrivacy carries one bidder's privacy.bidder record through the
+// cleanOpenRTBRequests loop. A nil value (no parity case in flight) makes its
+// methods no-ops.
+type parityPrivacy struct {
+	s      *trace.Session
+	bidder string
+	data   stagedata.PrivacyBidder
+	// transmit holds the transmit activities, reported only when the bidder
+	// was not blocked (the code evaluates them in applyPrivacy).
+	transmit stagedata.Activities
+}
+
+// parityPrivacyInput is what newParityPrivacy reads from the loop.
+type parityPrivacyInput struct {
+	wrapper     *openrtb_ext.RequestWrapper
+	activities  privacy.ActivityControl
+	permissions gdpr.AuctionPermissions
+	core        openrtb_ext.BidderName
+	bidder      string
+	alias       bool
+	ccpa        privacy.PolicyEnforcer
+	lmt         bool
+	coppa       bool
+}
+
+// newParityPrivacy starts the privacy.bidder record of one bidder, right before
+// isBidderBlockedByPrivacy. Activity results are re-evaluated here with the
+// same inputs the code uses: activity rules depend only on the component and
+// regs.gpp_sid, which nothing changes between this point and applyPrivacy, and
+// ActivityControl.Allow has no side effects.
+func newParityPrivacy(s *trace.Session, in parityPrivacyInput) *parityPrivacy {
+	if !s.Wants(parity.StagePrivacyBidder) || in.wrapper == nil {
+		return nil
+	}
+	scope := privacy.Component{Type: privacy.ComponentTypeBidder, Name: in.bidder}
+	allow := func(activity privacy.Activity) *bool {
+		return stagedata.BoolPtr(in.activities.Allow(activity, scope, privacy.NewRequestFromBidRequest(*in.wrapper)))
+	}
+	pp := &parityPrivacy{s: s, bidder: in.bidder}
+	pp.data = stagedata.PrivacyBidder{
+		Bidder: in.bidder,
+		Core:   string(in.core),
+		Alias:  in.alias,
+		GDPR: stagedata.GDPRPermissions{
+			AllowBidRequest: in.permissions.AllowBidRequest,
+			PassGeo:         in.permissions.PassGeo,
+			PassID:          in.permissions.PassID,
+		},
+		Activities: stagedata.Activities{FetchBids: allow(privacy.ActivityFetchBids)},
+		LMT:        in.lmt,
+		COPPA:      in.coppa,
+	}
+	if in.ccpa != nil {
+		pp.data.CCPAEnforced = in.ccpa.ShouldEnforce(in.bidder)
+	}
+	pp.transmit = stagedata.Activities{
+		TransmitUFPD:       allow(privacy.ActivityTransmitUserFPD),
+		TransmitPreciseGeo: allow(privacy.ActivityTransmitPreciseGeo),
+		TransmitTIDs:       allow(privacy.ActivityTransmitTIDs),
+	}
+	return pp
+}
+
+// blocked records a bidder isBidderBlockedByPrivacy dropped.
+func (pp *parityPrivacy) blocked() {
+	if pp == nil {
+		return
+	}
+	pp.data.Blocked = true
+	recordStage(pp.s, parity.StagePrivacyBidder, pp.bidder, pp.data)
+}
+
+// sent records a bidder whose request cleanOpenRTBRequests completed; the GPP
+// downgrade and down-conversion choices are the code's own pure predicates.
+func (pp *parityPrivacy) sent(bidderInfo config.BidderInfos) {
+	if pp == nil {
+		return
+	}
+	pp.data.Activities.TransmitUFPD = pp.transmit.TransmitUFPD
+	pp.data.Activities.TransmitPreciseGeo = pp.transmit.TransmitPreciseGeo
+	pp.data.Activities.TransmitTIDs = pp.transmit.TransmitTIDs
+	pp.data.GPPDowngraded = stagedata.BoolPtr(shouldSetLegacyPrivacy(bidderInfo, pp.data.Core))
+	info, ok := bidderInfo[pp.bidder]
+	pp.data.DownConverted = stagedata.BoolPtr(!ok || info.OpenRTB == nil || info.OpenRTB.Version != "2.6")
+	recordStage(pp.s, parity.StagePrivacyBidder, pp.bidder, pp.data)
+}
+
+// recordBidderResult records bidder.result for one bidder goroutine.
+func recordBidderResult(s *trace.Session, bidder openrtb_ext.BidderName, seatBids []*entities.PbsOrtbSeatBid, nonBids SeatNonBidBuilder, errs []error) {
+	if !s.Wants(parity.StageBidderResult) {
+		return
+	}
+	s.Record(parity.StageBidderResult, string(bidder), stagedata.BidderResult{
+		SeatBids: stagedata.SeatBidsSorted(seatBids),
+		NonBids:  stagedata.NonBidsOf(nonBids),
+	})
+	s.Errors(parity.StageBidderResult, string(bidder), errs)
+}
+
+// recordFloorsEnforce records floors.enforce.
+func recordFloorsEnforce(s *trace.Session, rejected []*entities.PbsOrtbSeatBid, errs []error) {
+	if !s.Wants(parity.StageFloorsEnforce) {
+		return
+	}
+	out := stagedata.FloorsEnforce{Rejected: make([]stagedata.FloorRejection, 0, len(rejected))}
+	if v, ok := s.LastDecision(parity.DecisionFloorsEnforce); ok {
+		out.Enforced = string(v) == "1"
+	}
+	for _, sb := range rejected {
+		if sb == nil || len(sb.Bids) == 0 || sb.Bids[0] == nil || sb.Bids[0].Bid == nil {
+			continue
+		}
+		out.Rejected = append(out.Rejected, floorRejectionOf(sb))
+	}
+	sort.SliceStable(out.Rejected, func(i, j int) bool {
+		a, b := out.Rejected[i], out.Rejected[j]
+		if a.Seat != b.Seat {
+			return a.Seat < b.Seat
+		}
+		if a.ImpID != b.ImpID {
+			return a.ImpID < b.ImpID
+		}
+		return a.BidID < b.BidID
+	})
+	s.Record(parity.StageFloorsEnforce, "", out)
+	s.Errors(parity.StageFloorsEnforce, "", errs)
+}
+
+// floorRejectionOf projects one rejected seat bid the way HoldAuction reports
+// it (one bid per rejected seat bid; the reason follows its deal ID).
+func floorRejectionOf(sb *entities.PbsOrtbSeatBid) stagedata.FloorRejection {
+	bid := sb.Bids[0]
+	out := stagedata.FloorRejection{
+		Seat:     sb.Seat,
+		BidID:    bid.Bid.ID,
+		ImpID:    bid.Bid.ImpID,
+		Price:    bid.Bid.Price,
+		Currency: sb.Currency,
+		DealID:   bid.Bid.DealID,
+		Reason:   int(ResponseRejectedBelowFloor),
+	}
+	if bid.Bid.DealID != "" {
+		out.Reason = int(ResponseRejectedBelowDealFloor)
+	}
+	if bid.BidFloors != nil {
+		out.Floor = bid.BidFloors.FloorValue
+		out.FloorCur = bid.BidFloors.FloorCurrency
+	}
+	return out
+}
+
+// recordCategoryMapping records category.mapping.
+func recordCategoryMapping(s *trace.Session, bidCategory map[string]string, rejections []string, err error) {
+	if !s.Wants(parity.StageCategoryMapping) {
+		return
+	}
+	out := stagedata.CategoryMapping{BidCategory: map[string]string{}, Rejections: []string{}}
+	for id, cat := range bidCategory {
+		out.BidCategory[id] = cat
+	}
+	out.Rejections = append(out.Rejections, rejections...)
+	s.Record(parity.StageCategoryMapping, "", out)
+	s.Errors(parity.StageCategoryMapping, "", errorList(err))
