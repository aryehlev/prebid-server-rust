+// recordEventsTracking records events.tracking after the bid IDs were generated
+// and the bids were modified for events.
+func recordEventsTracking(s *trace.Session, ev *eventTracking, seatBids map[openrtb_ext.BidderName]*entities.PbsOrtbSeatBid) {
+	if !s.Wants(parity.StageEventsTracking) || ev == nil {
+		return
+	}
+	out := stagedata.EventsTracking{
+		AccountID:          ev.accountID,
+		EnabledForAccount:  ev.enabledForAccount,
+		EnabledForRequest:  ev.enabledForRequest,
+		AuctionTimestampMS: ev.auctionTimestampMs,
+		IntegrationType:    ev.integrationType,
+		ExternalURL:        ev.externalURL,
+		Bids:               make(map[string][]stagedata.EventBid, len(seatBids)),
+	}
+	for seat, sb := range seatBids {
+		bids := []stagedata.EventBid{}
+		if sb != nil {
+			for _, bid := range sb.Bids {
+				bids = append(bids, eventBidOf(bid))
+			}
+		}
+		out.Bids[string(seat)] = bids
+	}
+	recordStage(s, parity.StageEventsTracking, "", out)
+}
