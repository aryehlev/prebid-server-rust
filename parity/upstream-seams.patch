+// TestParityInCallOrder: in parity mode the response loop gets a bidder's
+// responses in call order (MakeRequests order, then stored responses by imp
+// ID), whatever order they completed in.
+func TestParityInCallOrder(t *testing.T) {
+	reqs := []*adapters.RequestData{{Uri: "https://a/0"}, {Uri: "https://a/1"}, {Uri: "https://a/2"}}
+	stored := func(impID string) *httpCallInfo {
+		return &httpCallInfo{request: &adapters.RequestData{Body: []byte(ImpIdReqBody + impID)}}
+	}
+	stranger := &httpCallInfo{request: &adapters.RequestData{Uri: "https://other"}}
+	tests := []struct {
+		name      string
+		completed []*httpCallInfo
+		want      []string
+	}{
+		{"reversed calls", []*httpCallInfo{{request: reqs[2]}, {request: reqs[0]}, {request: reqs[1]}},
+			[]string{"https://a/0", "https://a/1", "https://a/2"}},
+		{"stored responses after the calls", []*httpCallInfo{stored("imp-b"), {request: reqs[1]}, stored("imp-a"), {request: reqs[0]}},
+			[]string{"https://a/0", "https://a/1", ImpIdReqBody + "imp-a", ImpIdReqBody + "imp-b"}},
+		{"unindexed calls last", []*httpCallInfo{stranger, {request: reqs[1]}},
+			[]string{"https://a/1", "https://other"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			pt := &parityBidderTrace{stored: []string{"imp-a", "imp-b"}}
+			pt.calls = map[*adapters.RequestData]int{reqs[0]: 0, reqs[1]: 1, reqs[2]: 2}
+			pt.numCalls = len(reqs)
+			ch := make(chan *httpCallInfo, len(tt.completed))
+			for _, info := range tt.completed {
+				ch <- info
+			}
+			out := pt.inCallOrder(ch, len(tt.completed))
+			got := make([]string, 0, len(tt.completed))
+			for range tt.completed {
+				info := <-out
+				if info.request.Uri != "" {
+					got = append(got, info.request.Uri)
+				} else {
+					got = append(got, string(info.request.Body))
+				}
+			}
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
