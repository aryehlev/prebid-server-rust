+// enforceOneBid runs Enforce on a single bid priced below a 5.01 USD floor with
+// the given account enforce rate and returns the rejected seat bids.
+func enforceOneBid(t *testing.T, enforceRate int) []*entities.PbsOrtbSeatBid {
+	t.Helper()
+	wrapper := &openrtb_ext.RequestWrapper{BidRequest: &openrtb2.BidRequest{
+		ID:  "r1",
+		Imp: []openrtb2.Imp{{ID: "imp1", Banner: &openrtb2.Banner{}, BidFloor: 5.01, BidFloorCur: "USD"}},
+		Ext: json.RawMessage(`{"prebid":{"floors":{"enabled":true,"enforcement":{"enforcepbs":true}}}}`),
+	}}
+	seatBids := map[openrtb_ext.BidderName]*entities.PbsOrtbSeatBid{
+		"pubmatic": {Seat: "pubmatic", Currency: "USD", Bids: []*entities.PbsOrtbBid{{Bid: &openrtb2.Bid{ID: "b1", ImpID: "imp1", Price: 1}}}},
+	}
+	account := config.Account{PriceFloors: config.AccountPriceFloors{Enabled: true, EnforceFloorsRate: enforceRate}}
+	_, errs, rejected := Enforce(wrapper, seatBids, account, convert{})
+	require.Empty(t, errs)
+	return rejected
+}
