+package exchange
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+	"github.com/stretchr/testify/require"
+)
+
+// pinnedDecisions pins every decision point the way generated parity cases do:
+// each binary point to value, floors.modelgroup to 0 and usersync.shuffle to
+// identity.
+func pinnedDecisions(value string) map[string]json.RawMessage {
+	out := map[string]json.RawMessage{}
+	for _, point := range parity.AllDecisions() {
+		switch point {
+		case parity.DecisionFloorsModelGroup:
+			out[string(point)] = json.RawMessage("0")
+		case parity.DecisionUsersyncShuffle:
+			out[string(point)] = json.RawMessage(`"` + parity.UsersyncShuffleIdentity + `"`)
+		default:
+			out[string(point)] = json.RawMessage(value)
+		}
+	}
+	return out
+}
+
+// TestParityPinnedDecisionsAreBehaviourNeutral replays every exchangetest
+// fixture with every decision point pinned, once to 0 and once to 1. The
+// fixtures are deterministic upstream (HoldAuction uses the real random source),
+// so each one only reaches decision sites whose outcome its configuration fixes,
+// for example floors enforcement at enforcerate 100. A pinned envelope value may
+// replace a genuinely random draw only; if it overrode a fixed outcome, Go in
+// parity mode would produce a response pristine Go never produces and runSpec's
+// own assertions would fail (observer effect).
+func TestParityPinnedDecisionsAreBehaviourNeutral(t *testing.T) {
+	specFiles, err := os.ReadDir("./exchangetest")
+	require.NoError(t, err)
+	for _, value := range []string{"0", "1"} {
+		for _, specFile := range specFiles {
+			if !strings.HasSuffix(specFile.Name(), ".json") {
+				continue
+			}
+			fileName := "./exchangetest/" + specFile.Name()
+			t.Run("pinned_"+value+"/"+specFile.Name(), func(t *testing.T) {
+				spec, err := loadFile(fileName)
+				require.NoError(t, err)
+				_, end := trace.Begin(&parity.Envelope{
+					Schema:        parity.SchemaEnvelope,
+					SchemaVersion: parity.SchemaVersion,
+					CaseID:        fileName,
+					Request:       parity.ExecRequest{Method: http.MethodPost, Path: "/openrtb2/auction", Headers: parity.HeaderList{}},
+					Decisions:     pinnedDecisions(value),
+				})
+				defer end()
+				runSpec(t, fileName, spec)
+			})
+		}
+	}
+}
