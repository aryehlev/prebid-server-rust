+
+// TestParityStartupGuardsFromEnv drives the real config loading path with the
+// PBS_PARITY_* environment variables an operator would set.
+func TestParityStartupGuardsFromEnv(t *testing.T) {
+	tests := []struct {
+		name    string
+		env     map[string]string
+		wantErr string
+		want    ParityConfig
+	}{
+		{
+			name:    "enabled without token fails",
+			env:     map[string]string{"PBS_PARITY_ENABLED": "true", "PBS_HOST": "127.0.0.1"},
+			wantErr: "parity.token",
+		},
+		{
+			name:    "enabled on all interfaces fails",
+			env:     map[string]string{"PBS_PARITY_ENABLED": "true", "PBS_PARITY_TOKEN": testParityToken, "PBS_HOST": "0.0.0.0"},
+			wantErr: "loopback",
+		},
+		{
+			name: "enabled on loopback starts",
+			env: map[string]string{
+				"PBS_PARITY_ENABLED": "true", "PBS_PARITY_TOKEN": testParityToken, "PBS_HOST": "127.0.0.1",
+				"PBS_PARITY_ORACLE_URL": "http://127.0.0.1:7999",
+			},
+			want: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://127.0.0.1:7999"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for k, v := range tt.env {
+				t.Setenv(k, v)
+			}
+			v := viper.New()
+			SetupViper(v, "", bidderInfos)
+			v.Set("gdpr.default_value", "0")
+			cfg, err := New(v, bidderInfos, mockNormalizeBidderName)
+			if tt.wantErr != "" {
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tt.wantErr)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, cfg.Parity)
+		})
+	}
+}
+
+func TestParityTokenIsRedactedInLogs(t *testing.T) {
+	var buf bytes.Buffer
+	logger := func(format string, a ...interface{}) {
+		fmt.Fprintf(&buf, format+"\n", a...)
+	}
+	cfg := ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://127.0.0.1:7999"}
+	logGeneralWithLogger(reflect.ValueOf(cfg), "parity", logger)
+	out := buf.String()
+	assert.NotContains(t, out, testParityToken)
+	assert.Contains(t, out, "parity.token: <REDACTED>")
+	assert.Contains(t, out, "parity.oracle_url: http://127.0.0.1:7999")
+	assert.True(t, strings.Contains(out, "parity.enabled: true"))
+}
