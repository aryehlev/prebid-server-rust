+func TestParityStageRecordersAreNilSafe(t *testing.T) {
+	require.Nil(t, trace.Current())
+	var pt *parityBidderTrace
+	var pp *parityPrivacy
+	info := &httpCallInfo{request: &adapters.RequestData{Uri: "u"}}
+	assert.NotPanics(t, func() {
