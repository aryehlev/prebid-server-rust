+// recordExchangeResponse records the exchange.response json from what
+// HoldAuction returned. Its error list belongs to the caller: every endpoint
+// attaches the returned error with endpointtrace.AuctionResult, so recording it
+// here as well would list a HoldAuction error twice.
+func recordExchangeResponse(s *trace.Session, resp *AuctionResponse) {
+	out := stagedata.ExchangeResponse{}
+	if resp != nil {
+		out.BidResponse = resp.BidResponse
+		out.ExtBidResponse = resp.ExtBidResponse
+	}
+	s.Record(parity.StageExchangeResponse, "", out)
+}
+
+// cacheResultTrace carries the doCache locals that cache.result records.
+type cacheResultTrace struct {
+	toCache              []prebid_cache_client.Cacheable
+	ids                  []string
+	bidIndices           map[int]*openrtb2.Bid
+	vastIndices          map[int]*openrtb2.Bid
+	competitiveExclusion bool
+	hbCacheID            string
+	errs                 []error
+}
+
+// recordCacheResult records cache.result after the auction stored the cache IDs.
+func recordCacheResult(s *trace.Session, a *auction, in cacheResultTrace) {
+	if !s.Wants(parity.StageCacheResult) {
+		return
+	}
+	out := stagedata.CacheResult{
+		Puts:                 make([]stagedata.CachePut, 0, len(in.toCache)),
+		CompetitiveExclusion: in.competitiveExclusion,
+		HBCacheID:            in.hbCacheID,
+	}
+	for i, c := range in.toCache {
+		out.Puts = append(out.Puts, cachePutOf(i, c, a, in))
+	}
+	sort.SliceStable(out.Puts, func(i, j int) bool { return cachePutLess(out.Puts[i], out.Puts[j]) })
+	s.Record(parity.StageCacheResult, "", out)
+	s.Errors(parity.StageCacheResult, "", in.errs)
+}
+
+func cachePutOf(i int, c prebid_cache_client.Cacheable, a *auction, in cacheResultTrace) stagedata.CachePut {
+	put := stagedata.CachePut{
+		Kind:       stagedata.CachePutDebugLog,
+		Type:       string(c.Type),
+		TTLSeconds: c.TTLSeconds,
+		Key:        c.Key,
+		Data:       c.Data,
+	}
+	if i < len(in.ids) {
+		put.ID = in.ids[i]
+	}
+	if bid, ok := in.bidIndices[i]; ok && bid != nil {
+		put.Kind, put.BidID, put.ImpID = stagedata.CachePutBid, bid.ID, bid.ImpID
+		put.Assigned = a.cacheIds[bid]
+	} else if bid, ok := in.vastIndices[i]; ok && bid != nil {
+		put.Kind, put.BidID, put.ImpID = stagedata.CachePutVAST, bid.ID, bid.ImpID
+		put.Assigned = a.vastCacheIds[bid]
+	}
+	return put
+}
+
+func cachePutLess(a, b stagedata.CachePut) bool {
+	if a.Kind != b.Kind {
+		return a.Kind < b.Kind
+	}
+	if a.BidID != b.BidID {
+		return a.BidID < b.BidID
+	}
+	if a.ImpID != b.ImpID {
+		return a.ImpID < b.ImpID
+	}
+	return string(a.Data) < string(b.Data)
+}
+
+// decideBool consults a binary parity decision point; without a parity case it
+// is exactly draw().
+func decideBool(point parity.DecisionID, draw func() bool) bool {
+	return trace.Current().DecideBool(point, draw)
+}
+
+// parityBidderTrace collects the parity stages of one BidderAdapter.requestBid
+// call. A nil receiver (no parity case in flight) makes every method a no-op,
+// so requestBid's hook lines cost one nil check each.
+type parityBidderTrace struct {
+	s        *trace.Session
+	bidder   string
+	calls    map[*adapters.RequestData]int
+	numCalls int
+	// stored holds the stored bid response imp IDs, sorted; their calls are
+	// indexed after the MakeRequests calls in this order.
+	stored   []string
+	adjusted map[string]*stagedata.BidsAdjusted
+	// turn is the bidder's turn to build its requests (parity_turns.go),
+	// ended once MakeRequests returned; nil when the bidders run freely.
+	turn *parityTurn
+}
+
+// parityBidderStart starts tracing one requestBid call. It returns ctx
+// attributed to the bidder (the parity transport then labels the bidder's calls
+// kind "bidder") and the call's tracer. Without a parity case in flight it
+// returns ctx unchanged and a nil tracer.
+func parityBidderStart(ctx context.Context, bidderRequest BidderRequest) (context.Context, *parityBidderTrace) {
+	s := trace.Current()
+	if s == nil {
+		return ctx, nil
+	}
+	bidder := string(bidderRequest.BidderName)
+	stored := make([]string, 0, len(bidderRequest.BidderStoredResponses))
+	for impID := range bidderRequest.BidderStoredResponses {
+		stored = append(stored, impID)
+	}
+	sort.Strings(stored)
+	pt := &parityBidderTrace{s: s, bidder: bidder, stored: stored, adjusted: map[string]*stagedata.BidsAdjusted{}}
+	pt.turn = parityTurnOf(ctx, bidderRequest.BidderName)
+	return trace.WithBidder(ctx, bidder), pt
+}
+
+// parityBidderContext attributes ctx to bidder while a parity case is in flight
+// (timeout notifications run outside requestBid's context).
+func parityBidderContext(ctx context.Context, bidder openrtb_ext.BidderName) context.Context {
+	if trace.Current() == nil {
+		return ctx
+	}
+	return trace.WithBidder(ctx, string(bidder))
+}
+
+// hookRejected records a bidder-request hook reject.
+func (pt *parityBidderTrace) hookRejected(reject *hookexecution.RejectError) {
+	if pt == nil {
+		return
+	}
+	pt.s.Record(parity.StageHooksBidderRequest, pt.bidder, stagedata.HookRequest{Rejected: true})
+	pt.s.Errors(parity.StageHooksBidderRequest, pt.bidder, rejectList(reject))
+}
+
+// bidderRequestHook records the bidder request right after requestBid rebuilt
+// it following the bidder-request hook stage.
+func (pt *parityBidderTrace) bidderRequestHook(req *openrtb2.BidRequest) {
+	if pt == nil {
+		return
+	}
+	pt.s.Record(parity.StageHooksBidderRequest, pt.bidder, stagedata.HookRequest{Request: req})
+	pt.s.Errors(parity.StageHooksBidderRequest, pt.bidder, nil)
+}
+
+// adapterRequests records MakeRequests' output before any header injection.
+func (pt *parityBidderTrace) adapterRequests(reqData []*adapters.RequestData, errs []error) {
+	if pt == nil {
+		return
+	}
+	pt.turn.end()
+	pt.s.Record(parity.StageAdapterRequests, pt.bidder, stagedata.RequestsOf(reqData))
+	pt.s.Errors(parity.StageAdapterRequests, pt.bidder, errs)
+}
+
+// adapterRequestsFinal records the requests as handed to doRequest and indexes
+// them for the bidder#call keys.
+func (pt *parityBidderTrace) adapterRequestsFinal(reqData []*adapters.RequestData, errs []error) {
+	if pt == nil {
+		return
+	}
+	pt.calls = make(map[*adapters.RequestData]int, len(reqData))
+	for i, req := range reqData {
+		pt.calls[req] = i
+	}
+	pt.numCalls = len(reqData)
+	pt.s.Record(parity.StageAdapterRequestsFinal, pt.bidder, stagedata.RequestsOf(reqData))
+	pt.s.Errors(parity.StageAdapterRequestsFinal, pt.bidder, errs)
+}
+
+// callIndex returns the zero-based call index of info's request: MakeRequests
+// order first, then the stored bid responses by imp ID. ok is false for a
+// request requestBid did not issue.
+func (pt *parityBidderTrace) callIndex(info *httpCallInfo) (int, bool) {
+	if info == nil {
+		return 0, false
+	}
+	if i, ok := pt.calls[info.request]; ok {
+		return i, true
+	}
+	if info.request == nil || info.request.Uri != "" {
+		return 0, false
+	}
+	impID := strings.TrimPrefix(string(info.request.Body), ImpIdReqBody)
+	pos := sort.SearchStrings(pt.stored, impID)
+	if pos < len(pt.stored) && pt.stored[pos] == impID {
+		return pt.numCalls + pos, true
+	}
+	return 0, false
+}
+
+// inCallOrder hands a bidder's n responses to requestBid's response loop in
+// call order (callIndex) while a parity case is in flight. Go reads them in
+// completion order, and some outcomes depend on that order: after the first
+// MakeBids requestBid sets an empty request cur to USD, which adgeneration's
+// MakeBids reads (exchange/bidder.go:327-329), and flipp's MakeBids keeps its
+// imp params in a package variable (adapters/flipp/flipp.go:37). It waits for
+// all n responses, which every call delivers by the request deadline. Calls
+// without an index keep their completion order after the indexed ones. A nil
+// receiver, or fewer than two responses, returns ch unchanged.
+func (pt *parityBidderTrace) inCallOrder(ch chan *httpCallInfo, n int) chan *httpCallInfo {
+	if pt == nil || n < 2 {
+		return ch
+	}
+	infos := make([]*httpCallInfo, n)
+	for i := range infos {
+		infos[i] = <-ch
+	}
+	order := func(info *httpCallInfo) int {
+		if i, ok := pt.callIndex(info); ok {
+			return i
+		}
+		return pt.numCalls + len(pt.stored)
+	}
+	sort.SliceStable(infos, func(i, j int) bool { return order(infos[i]) < order(infos[j]) })
+	out := make(chan *httpCallInfo, n)
+	for _, info := range infos {
+		out <- info
+	}
+	return out
+}
+
+// callKey returns the bidder#call stage key of info.
+func (pt *parityBidderTrace) callKey(info *httpCallInfo) string {
+	if i, ok := pt.callIndex(info); ok {
+		return fmt.Sprintf("%s#%d", pt.bidder, i)
+	}
+	return pt.bidder + "#unindexed"
+}
+
+// makeBids runs MakeBids for one call, or returns the parity bidder_response
+// mock for a mocked call, and records adapter.bids. With a nil receiver it is
+// exactly the adapter's MakeBids.
+func (pt *parityBidderTrace) makeBids(b adapters.Bidder, req *openrtb2.BidRequest, info *httpCallInfo) (*adapters.BidderResponse, []error) {
+	if pt == nil {
+		if info.parityMocked {
+			return nil, nil
+		}
+		return b.MakeBids(req, info.request, info.response)
+	}
+	var (
+		resp *adapters.BidderResponse
+		errs []error
+	)
+	if info.parityMocked {
+		resp, errs = pt.mockedBids(info)
+	} else {
+		resp, errs = b.MakeBids(req, info.request, info.response)
+	}
+	pt.recordAdapterBids(info, resp, errs)
+	return resp, errs
+}
+
+// mockedBids returns the envelope's bidder_response for the bidder's first call
+// and nothing for its other calls, so the mock enters the auction once.
+func (pt *parityBidderTrace) mockedBids(info *httpCallInfo) (*adapters.BidderResponse, []error) {
+	if i, ok := pt.callIndex(info); !ok || i != 0 {
+		return nil, nil
+	}
+	resp, errs, ok := ParityMockBidderResponse(openrtb_ext.BidderName(pt.bidder))
+	if !ok {
+		return nil, nil
+	}
+	return resp, errs
+}
+
+func (pt *parityBidderTrace) recordAdapterBids(info *httpCallInfo, resp *adapters.BidderResponse, errs []error) {
+	if !pt.s.Wants(parity.StageAdapterBids) {
+		return
+	}
+	key := pt.callKey(info)
+	bidderResponse, err := stagedata.BidderResponseOf(resp)
+	if err != nil {
+		pt.s.Note("adapter.bids %s: %v", key, err)
+	}
+	pt.s.Record(parity.StageAdapterBids, key, stagedata.AdapterBids{
+		RequestData:    stagedata.RequestDataOf(info.request),
+		Response:       stagedata.ResponseDataOf(info.response),
+		BidderResponse: bidderResponse,
+		Mocked:         info.parityMocked,
+	})
+	pt.s.Errors(parity.StageAdapterBids, key, errs)
+}
+
+// rawBidderResponse records hooks.raw_bidder_response for one call.
+func (pt *parityBidderTrace) rawBidderResponse(info *httpCallInfo, resp *adapters.BidderResponse, reject *hookexecution.RejectError) {
+	if pt == nil || !pt.s.Wants(parity.StageHooksRawBidderResponse) {
+		return
+	}
+	key := pt.callKey(info)
+	out := stagedata.RawBidderResponse{RequestData: stagedata.RequestDataOf(info.request), Rejected: reject != nil}
+	if reject == nil {
+		bidderResponse, err := stagedata.BidderResponseOf(resp)
+		if err != nil {
+			pt.s.Note("hooks.raw_bidder_response %s: %v", key, err)
+		}
+		out.BidderResponse = bidderResponse
+	}
+	pt.s.Record(parity.StageHooksRawBidderResponse, key, out)
+	pt.s.Errors(parity.StageHooksRawBidderResponse, key, rejectList(reject))
+}
+
+func (pt *parityBidderTrace) seatAdjustments(seat string) *stagedata.BidsAdjusted {
+	adj, ok := pt.adjusted[seat]
+	if !ok {
+		adj = &stagedata.BidsAdjusted{Bids: []stagedata.AdjustedBid{}, ConversionErrors: []stagedata.ConversionError{}}
+		pt.adjusted[seat] = adj
+	}
+	return adj
+}
+
+func (pt *parityBidderTrace) adjustedBidOf(info *httpCallInfo, bid *adapters.TypedBid, originalCur string) stagedata.AdjustedBid {
+	out := stagedata.AdjustedBid{Call: pt.callKey(info), Bidder: pt.bidder, OriginalCur: originalCur}
+	if bid != nil && bid.Bid != nil {
+		out.BidID, out.ImpID = bid.Bid.ID, bid.Bid.ImpID
+	}
+	return out
+}
+
+// altCodeRejected records a bid dropped because its seat is not an allowed
+// alternate bidder code. It must be called before any price change.
+func (pt *parityBidderTrace) altCodeRejected(info *httpCallInfo, seat openrtb_ext.BidderName, bid *adapters.TypedBid, originalCur string) {
+	if pt == nil {
+		return
+	}
+	out := pt.adjustedBidOf(info, bid, originalCur)
+	if bid != nil && bid.Bid != nil {
+		out.OriginalCPM = bid.Bid.Price
+	}
+	adj := pt.seatAdjustments(string(seat))
+	adj.Bids = append(adj.Bids, out)
+}
+
+// bidAdjusted records one bid after currency conversion and adjustments.
+func (pt *parityBidderTrace) bidAdjusted(info *httpCallInfo, seat openrtb_ext.BidderName, bid *adapters.TypedBid, originalCPM float64, originalCur string, factor, rate float64, currencyAfter string) {
+	if pt == nil {
+		return
+	}
+	out := pt.adjustedBidOf(info, bid, originalCur)
+	out.OriginalCPM = originalCPM
+	out.AltCodeValid = true
+	out.Factor, out.ConversionRate, out.CurrencyAfter = &factor, &rate, &currencyAfter
+	if bid != nil && bid.Bid != nil {
+		price := bid.Bid.Price
+		out.RuleAdjustedPrice = &price
+	}
+	adj := pt.seatAdjustments(string(seat))
+	adj.Bids = append(adj.Bids, out)
+}
+
+// conversionFailed records a response whose bids were dropped for lack of a
+// conversion rate.
+func (pt *parityBidderTrace) conversionFailed(info *httpCallInfo, responseCurrency string, requestCurrencies []string, err error) {
+	if pt == nil {
+		return
+	}
+	adj := pt.seatAdjustments(pt.bidder)
+	adj.ConversionErrors = append(adj.ConversionErrors, stagedata.ConversionError{
+		Call:              pt.callKey(info),
+		ResponseCurrency:  responseCurrency,
+		RequestCurrencies: append([]string{}, requestCurrencies...),
+		Error:             trace.ErrorRecordOf(err),
+	})
+}
+
+// finish records bids.adjusted for every seat that saw a bid or a conversion
+// failure.
+func (pt *parityBidderTrace) finish() {
+	if pt == nil {
+		return
+	}
+	for seat, adj := range pt.adjusted {
+		recordStage(pt.s, parity.StageBidsAdjusted, seat, adj)
+	}
+}
+
+// parityMockedCall short-circuits doRequest for a bidder whose MakeBids output
+// the parity case mocks (mock.level=bidder_response): no HTTP request is sent
+// and makeBids returns the mock instead. It returns nil otherwise.
+func parityMockedCall(ctx context.Context, req *adapters.RequestData) *httpCallInfo {
+	s := trace.Current()
+	if s == nil || s.Envelope().Mock.EffectiveLevel() != parity.MockLevelBidderResp {
+		return nil
+	}
+	bidder, ok := trace.BidderFrom(ctx)
+	if !ok {
+		return nil
+	}
+	if _, mocked := s.Envelope().Mock.BidderResponses[bidder]; !mocked {
+		return nil
+	}
+	return &httpCallInfo{request: req, parityMocked: true}
+}
+
+// parityNoteThrottle notes that bidder throttling consulted its random source.
+// Throttling is not a decision point (decisions.json not_decisions): parity
+// profiles disable it, so a note here flags a case that depends on it.
+func parityNoteThrottle(bidder openrtb_ext.BidderName, health, probability float64) {
+	if s := trace.Current(); s != nil {
+		s.Note("bidder throttling consulted its random source for %s (health %.4f, throttle probability %.4f); throttling is not a decision point", bidder, health, probability)
+	}
+}
