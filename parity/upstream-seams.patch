+			run: func() any { return getCpmTarget(1.55, 0, 0.1, 2, config.RoundingModeTimeSplit) }, want: "1.50", wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
+			name: "timesplit 0 ceils", point: parity.DecisionPriceGranularityTimesplit, value: "0",
+			run: func() any { return getCpmTarget(1.55, 0, 0.1, 2, config.RoundingModeTimeSplit) }, want: "1.60", wantSource: parity.DecisionSourceEnvelope,
+		},
