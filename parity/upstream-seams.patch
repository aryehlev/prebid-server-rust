+package pbs
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/prebid/prebid-server/v4/config"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/transport"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestVerifyRecaptchaParityMode: the /optout recaptcha check builds its own
+// transport per call, so in parity mode it must still go to the oracle (as an
+// absolute-form proxy request carrying X-Parity-Meta) and never to Google.
+func TestVerifyRecaptchaParityMode(t *testing.T) {
+	var proxied atomic.Int32
+	oracle := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		proxied.Add(1)
+		assert.Equal(t, "www.google.com", r.URL.Host, "absolute-form request for the original host")
+		assert.Equal(t, "/recaptcha/api/siteverify", r.URL.Path)
+		assert.NotEmpty(t, r.Header.Get(parity.MetaHeader), "parity meta header")
+		body, err := io.ReadAll(r.Body)
+		assert.NoError(t, err)
+		assert.Contains(t, string(body), "response=token")
+		w.Header().Set("Content-Type", "application/json")
+		_, err = io.WriteString(w, `{"success":true}`)
+		assert.NoError(t, err)
+	}))
+	defer oracle.Close()
+
+	transport.SetProcessConfig(&config.ParityConfig{Enabled: true, Token: "0123456789abcdef", OracleURL: oracle.URL})
+	defer transport.SetProcessConfig(nil)
+
+	deps := &UserSyncDeps{RecaptchaSecret: "secret"}
+	require.NoError(t, deps.VerifyRecaptcha("token"))
+	assert.Equal(t, int32(1), proxied.Load())
+}
