+const testParityToken = "0123456789abcdef"
+
+func TestParityConfigValidate(t *testing.T) {
+	tests := []struct {
+		name     string
+		cfg      ParityConfig
+		host     string
+		wantErrs []string
+	}{
+		{name: "disabled is a no-op even when unsafe", cfg: ParityConfig{OracleURL: "https://remote"}, host: "0.0.0.0"},
+		{name: "enabled loopback ok", cfg: ParityConfig{Enabled: true, Token: testParityToken}, host: "127.0.0.1"},
+		{name: "enabled localhost with oracle ok", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://localhost:7999"}, host: "localhost"},
+		{name: "enabled ipv6 loopback ok", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://[::1]:7999"}, host: "::1"},
+		{name: "missing token", cfg: ParityConfig{Enabled: true}, host: "127.0.0.1", wantErrs: []string{"parity.token must be at least 16 characters"}},
+		{name: "short token", cfg: ParityConfig{Enabled: true, Token: "short"}, host: "127.0.0.1", wantErrs: []string{"parity.token"}},
+		{name: "all interfaces rejected", cfg: ParityConfig{Enabled: true, Token: testParityToken}, host: "", wantErrs: []string{"requires host to be a loopback address"}},
+		{name: "wildcard host rejected", cfg: ParityConfig{Enabled: true, Token: testParityToken}, host: "0.0.0.0", wantErrs: []string{"requires host to be a loopback address"}},
+		{name: "public host allowed by override", cfg: ParityConfig{Enabled: true, Token: testParityToken, AllowNonLoopback: true}, host: "0.0.0.0"},
+		{name: "https oracle rejected", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "https://127.0.0.1:7999"}, host: "127.0.0.1", wantErrs: []string{"absolute http URL"}},
+		{name: "relative oracle rejected", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "127.0.0.1:7999"}, host: "127.0.0.1", wantErrs: []string{"oracle_url"}},
+		{name: "remote oracle rejected", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://10.0.0.8:7999"}, host: "127.0.0.1", wantErrs: []string{"must point at a loopback address"}},
+		{name: "remote oracle allowed by override", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://10.0.0.8:7999", AllowNonLoopback: true}, host: "127.0.0.1"},
+		{name: "invalid oracle url", cfg: ParityConfig{Enabled: true, Token: testParityToken, OracleURL: "http://[::1"}, host: "127.0.0.1", wantErrs: []string{"parity.oracle_url is invalid"}},
+		{
+			name:     "errors accumulate",
+			cfg:      ParityConfig{Enabled: true, OracleURL: "http://10.0.0.8"},
+			host:     "0.0.0.0",
+			wantErrs: []string{"parity.token", "loopback address", "must point at a loopback address"},
+		},
