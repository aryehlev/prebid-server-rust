+			decisions: map[string]string{string(parity.DecisionFloorsSkip): "0"},
+			run:       func() any { return shouldSkipFloors(10, 0, 0, constant(0)) },
+			want:      false, wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
