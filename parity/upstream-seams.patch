+			decisions: map[string]string{string(parity.DecisionFloorsDataRate): "1"},
+			run:       func() any { return useFetchedData(&zero) },
+			want:      false, wantSource: parity.DecisionSourceRNG,
+		},
+		{
+			name:      "skip rate 100 always skips whatever the envelope pins",
+			decisions: map[string]string{string(parity.DecisionFloorsSkip): "0"},
+			run:       func() any { return shouldSkipFloors(100, 0, 0, constant(100)) },
+			want:      true, wantSource: parity.DecisionSourceRNG,
+		},
+		{
+			name: "data rate is not consulted without usefetchdatarate",
+			run:  func() any { return useFetchedData(nil) },
+			want: true,
+		},
+		{
+			name:      "model group override picks the sorted index",
+			decisions: map[string]string{string(parity.DecisionFloorsModelGroup): "1"},
+			run:       func() any { return selectFloorModelGroup(modelGroups(50, 10, 40), constant(0))[0].ModelVersion },
+			want:      "c", wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
+			name:      "model group override out of range falls back to the weighted draw",
+			decisions: map[string]string{string(parity.DecisionFloorsModelGroup): "5"},
+			run:       func() any { return selectFloorModelGroup(modelGroups(50, 10, 40), constant(30))[0].ModelVersion },
+			want:      "c", wantSource: parity.DecisionSourceRNG,
+		},
+		{
+			name: "model group without override is the original weighted draw",
+			run:  func() any { return selectFloorModelGroup(modelGroups(50, 10, 40), constant(51))[0].ModelVersion },
+			want: "a", wantSource: parity.DecisionSourceRNG,
+		},
+		{
