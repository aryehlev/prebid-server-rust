+			name:      "enforce override 1 rejects the bid below floor",
+			decisions: map[string]string{string(parity.DecisionFloorsEnforce): "1"},
+			run:       func() any { return len(enforceOneBid(t, ten)) },
+			want:      1, wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
+			name:      "enforce rate 0 (always) enforces whatever the envelope pins",
+			decisions: map[string]string{string(parity.DecisionFloorsEnforce): "0"},
+			run:       func() any { return len(enforceOneBid(t, zero)) },
+			want:      1, wantSource: parity.DecisionSourceRNG,
+		},
+		{
+			name:      "enforce rate 100 enforces whatever the envelope pins",
+			decisions: map[string]string{string(parity.DecisionFloorsEnforce): "0"},
