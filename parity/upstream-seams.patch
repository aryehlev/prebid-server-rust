+func TestParityRateUncertainty(t *testing.T) {
+	tests := []struct {
+		name string
+		got  bool
+		want bool
+	}{
+		{name: "skip 0", got: skipRateUncertain(0), want: false},
+		{name: "skip 1", got: skipRateUncertain(1), want: true},
+		{name: "skip 99", got: skipRateUncertain(99), want: true},
+		{name: "skip 100", got: skipRateUncertain(100), want: false},
+		{name: "data -1", got: dataRateUncertain(-1), want: false},
+		{name: "data 0", got: dataRateUncertain(0), want: false},
+		{name: "data 50", got: dataRateUncertain(50), want: true},
+		{name: "data 100", got: dataRateUncertain(100), want: false},
+		{name: "enforce 0/0 always", got: enforceRateUncertain(0, 0), want: false},
+		{name: "enforce 0/100 always", got: enforceRateUncertain(0, 100), want: false},
+		{name: "enforce 100/0 always", got: enforceRateUncertain(100, 0), want: false},
+		{name: "enforce 50/0", got: enforceRateUncertain(50, 0), want: true},
+		{name: "enforce 0/50", got: enforceRateUncertain(0, 50), want: true},
+		{name: "enforce 50/100", got: enforceRateUncertain(50, 100), want: true},
+		{name: "enforce -1/50 never", got: enforceRateUncertain(-1, 50), want: false},
+		{name: "enforce 50/-1 never", got: enforceRateUncertain(50, -1), want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.want, tt.got)
+		})
+	}
+}
