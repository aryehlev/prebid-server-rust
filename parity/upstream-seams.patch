+// parityRun is the observable outcome of one endpoint call.
+type parityRun struct {
+	code      int
+	body      string
+	validated string // the request the exchange received, as jsonutil marshals it
+	trace     *parity.Trace
+}
+
+// serve calls handler with req, inside a parity session when traced.
+func serve(t *testing.T, handler httprouter.Handle, req *http.Request, traced bool) (*httptest.ResponseRecorder, *parity.Trace) {
+	t.Helper()
+	recorder := httptest.NewRecorder()
+	if !traced {
+		require.Nil(t, trace.Current())
+		handler(recorder, req, nil)
+		return recorder, nil
+	}
+	s, end := trace.Begin(&parity.Envelope{CaseID: t.Name(), Request: parity.ExecRequest{Path: req.URL.Path}})
+	defer end()
+	handler(recorder, req, nil)
+	snap := s.Snapshot()
+	return recorder, &snap
+}
