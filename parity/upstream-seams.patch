+// recordAllProcessedBidResponses records hooks.all_processed_bid_responses.
+func recordAllProcessedBidResponses(s *trace.Session, seatBids map[openrtb_ext.BidderName]*entities.PbsOrtbSeatBid) {
+	if !s.Wants(parity.StageHooksAllProcessedBidResponses) {
+		return
+	}
+	recordStage(s, parity.StageHooksAllProcessedBidResponses, "", stagedata.SeatBidMapOf(seatBids))
+}
+
+// recordAuctionWinners records auction.winners after multibid limits, price
+// rounding and deal support were applied.
+func recordAuctionWinners(s *trace.Session, auc *auction) {
+	if !s.Wants(parity.StageAuctionWinners) || auc == nil {
+		return
+	}
+	out := stagedata.AuctionWinners{Imps: make(map[string]stagedata.ImpWinners, len(auc.allBidsByBidder))}
+	for impID, perSeat := range auc.allBidsByBidder {
+		imp := stagedata.ImpWinners{Seats: make(map[string][]stagedata.RankedBid, len(perSeat))}
+		if winner, ok := auc.winningBids[impID]; ok && winner != nil {
+			ranked := rankedBidOf(winner, auc.roundedPrices)
+			imp.Winner = &ranked
+		}
+		for seat, bids := range perSeat {
+			ranked := make([]stagedata.RankedBid, 0, len(bids))
+			for _, bid := range bids {
+				ranked = append(ranked, rankedBidOf(bid, auc.roundedPrices))
+			}
+			imp.Seats[string(seat)] = ranked
+		}
+		out.Imps[impID] = imp
+	}
+	recordStage(s, parity.StageAuctionWinners, "", out)
+}
+
+func rankedBidOf(bid *entities.PbsOrtbBid, rounded map[*entities.PbsOrtbBid]string) stagedata.RankedBid {
+	if bid == nil {
+		return stagedata.RankedBid{}
+	}
+	out := stagedata.RankedBid{
+		DealPriority:      bid.DealPriority,
+		DealTierSatisfied: bid.DealTierSatisfied,
+		RoundedPrice:      rounded[bid],
+	}
+	if bid.Bid != nil {
+		out.BidID = bid.Bid.ID
+		out.Price = bid.Bid.Price
+		out.DealID = bid.Bid.DealID
+	}
+	return out
+}
+
+// recordTargeting records targeting after setTargeting.
+func recordTargeting(s *trace.Session, auc *auction) {
+	if !s.Wants(parity.StageTargeting) || auc == nil {
+		return
+	}
+	out := stagedata.Targeting{Imps: make(map[string]map[string][]stagedata.TargetedBid, len(auc.allBidsByBidder))}
+	for impID, perSeat := range auc.allBidsByBidder {
+		seats := make(map[string][]stagedata.TargetedBid, len(perSeat))
+		for seat, bids := range perSeat {
+			targeted := make([]stagedata.TargetedBid, 0, len(bids))
+			for _, bid := range bids {
+				if bid == nil || bid.Bid == nil {
+					continue
+				}
+				targeted = append(targeted, stagedata.TargetedBid{BidID: bid.Bid.ID, Targets: bid.BidTargets})
+			}
+			seats[string(seat)] = targeted
+		}
+		out.Imps[impID] = seats
+	}
+	recordStage(s, parity.StageTargeting, "", out)
+}
