+func loadFixture(t *testing.T, file string) ([]byte, testCase) {
+	t.Helper()
+	fileData, err := os.ReadFile(file)
+	require.NoError(t, err)
+	test, err := parseTestData(fileData, file)
+	require.NoError(t, err)
+	return fileData, test
+}
+
+// runAuctionFixture runs an /openrtb2/auction sample request the way
+// runJsonBasedTest does.
+func runAuctionFixture(t *testing.T, file string, traced bool) parityRun {
+	t.Helper()
+	_, test := loadFixture(t, file)
+	cfg := &config.Configuration{MaxRequestSize: maxSize}
+	if test.Config != nil {
+		cfg.BlockedApps = test.Config.BlockedApps
+		cfg.BlockedAppsLookup = test.Config.getBlockedAppLookup()
+		cfg.AccountRequired = test.Config.AccountRequired
+		cfg.AccountDefaults.PreferredMediaType = test.Config.PreferredMediaType
+	}
+	cfg.MarshalAccountDefaults()
+	test.endpointType = OPENRTB_ENDPOINT
+
+	handler, ex, bidServers, currencyServer, err := buildTestEndpoint(test, cfg)
+	require.NoError(t, err)
+	defer closeServers(bidServers, currencyServer)
+
+	recorder, snap := serve(t, handler, httptest.NewRequest("POST", "/openrtb2/auction", bytes.NewReader(test.BidRequest)), traced)
+	require.Equal(t, test.ExpectedReturnCode, recorder.Code, recorder.Body.String())
+	return parityRun{code: recorder.Code, body: recorder.Body.String(), validated: marshalJSON(t, ex.actualValidatedBidReq), trace: snap}
+}
