+		{code: errortypes.BidderTemporarilyThrottledErrorCode, wantCode: errortypes.BidderTemporarilyThrottledErrorCode, warning: true},
+		{code: errortypes.NoConversionRateErrorCode, wantCode: errortypes.UnknownErrorCode},
+		{code: errortypes.UnknownErrorCode, wantCode: errortypes.UnknownErrorCode},
+		{code: errortypes.InvalidPrivacyConsentWarningCode, wantCode: errortypes.InvalidPrivacyConsentWarningCode, warning: true},
+		{code: errortypes.BidAdjustmentWarningCode, wantCode: errortypes.BidAdjustmentWarningCode, warning: true},
