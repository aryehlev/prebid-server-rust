+		{name: "no session", env: nil, bidder: "appnexus"},
+		{name: "http level", env: &parity.Envelope{Mock: parity.MockSpec{BidderResponses: mocks}}, bidder: "appnexus"},
+		{name: "bidder level hit", env: &parity.Envelope{Mock: parity.MockSpec{Level: parity.MockLevelBidderResp, BidderResponses: mocks}}, bidder: "appnexus", wantOK: true, wantBids: 1},
+		{name: "bidder level miss", env: &parity.Envelope{Mock: parity.MockSpec{Level: parity.MockLevelBidderResp, BidderResponses: mocks}}, bidder: "rubicon"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.env != nil {
+				_, end := trace.Begin(tt.env)
+				defer end()
+			}
+			resp, errs, ok := ParityMockBidderResponse(tt.bidder)
+			assert.Equal(t, tt.wantOK, ok)
+			if !tt.wantOK {
+				assert.Nil(t, resp)
+				assert.Nil(t, errs)
+				return
+			}
+			assert.Empty(t, errs)
+			assert.Len(t, resp.Bids, tt.wantBids)
+		})
+	}
+}
+
+// TestParityFakesMakeAdaptersDeterministic runs the real MakeRequests of the 8
+// adapters with internal randomness or wall-clock reads, built the way the
+// parity adapter endpoint builds them, and checks that the installed fakes make
+// their output deterministic and carry the fakes.json values.
+func TestParityFakesMakeAdaptersDeterministic(t *testing.T) {
+	fakes.Uninstall()
+	fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+
+	huaweiExtra := `{"pkgNameConvert":[],"closeSiteSelectionByCountry":"1"}`
+	tests := []struct {
+		bidder   openrtb_ext.BidderName
+		adapter  config.Adapter
+		fixture  string
+		mutate   func(req map[string]any)
+		reqInfo  adapters.ExtraRequestInfo
+		wantPart string
+	}{
+		{bidder: openrtb_ext.BidderAdnuntius, adapter: config.Adapter{Endpoint: "http://whatever.url", ExtraAdapterInfo: "http://gdpr.url"},
+			fixture: "../adapters/adnuntius/adnuntiustest/exemplary/simple-banner.json", wantPart: "tzo=0"},
+		{bidder: openrtb_ext.BidderAppnexus, adapter: config.Adapter{Endpoint: "http://ib.adnxs.com/openrtb2"},
+			fixture: "../adapters/appnexus/appnexustest/video/video-same-adpodid-two-imps-same-pod.json",
+			reqInfo: adapters.ExtraRequestInfo{PbsEntryPoint: metrics.ReqTypeVideo}, wantPart: `"adpod_id":"10"`},
+		{bidder: openrtb_ext.BidderCadentApertureMX, adapter: config.Adapter{Endpoint: "https://hb.emxdgt.com"},
+			fixture: "../adapters/cadent_aperture_mx/cadent_aperture_mxtest/exemplary/banner-app.json", mutate: dropTest, wantPart: "ts=1629473330&"},
+		{bidder: openrtb_ext.BidderEPlanning, adapter: config.Adapter{Endpoint: "http://rtb.e-planning.net/pbs/1"},
+			fixture: "../adapters/eplanning/eplanningtest/exemplary/simple-banner.json", wantPart: "rnd=10"},
+		{bidder: openrtb_ext.BidderFlipp, adapter: config.Adapter{Endpoint: "http://example.com/pserver"},
+			fixture: "../adapters/flipp/flipptest/exemplary/simple-banner-native-param-user-coppa.json", wantPart: fakes.DefaultUUID},
+		{bidder: openrtb_ext.BidderHuaweiAds, adapter: config.Adapter{Endpoint: "https://huaweiads.com/adxtest/", ExtraAdapterInfo: huaweiExtra},
+			fixture: "../adapters/huaweiads/huaweiadstest/exemplary/banner1.json", mutate: dropHuaweiTestAuthorization, wantPart: "nonce=1629473330823"},
+		{bidder: openrtb_ext.BidderTappx, adapter: config.Adapter{Endpoint: "http://{{.Host}}"},
+			fixture: "../adapters/tappx/tappxtest/exemplary/single-banner-impression.json", mutate: dropTest, wantPart: "ts=1629473330823"},
+		{bidder: openrtb_ext.BidderYieldlab, adapter: config.Adapter{Endpoint: "https://ad.yieldlab.net/testing/"},
+			fixture: "../adapters/yieldlab/yieldlabtest/exemplary/banner.json", wantPart: "ts=1629473330"},
+	}
+	for _, tt := range tests {
+		t.Run(string(tt.bidder), func(t *testing.T) {
+			bidder, err := BuildParityBidder(tt.bidder, tt.adapter, config.Server{ExternalUrl: "http://hosturl.com", GvlID: 1, DataCenter: "2"}, config.BidderInfo{}, false)
+			require.NoError(t, err)
+			first := makeRequestsFingerprint(t, bidder, loadMockBidRequest(t, tt.fixture, tt.mutate), tt.reqInfo)
+			second := makeRequestsFingerprint(t, bidder, loadMockBidRequest(t, tt.fixture, tt.mutate), tt.reqInfo)
+			assert.Equal(t, first, second, "fakes make MakeRequests deterministic")
+			assert.Contains(t, first, tt.wantPart)
+		})
+	}
+}
+
+func dropTest(req map[string]any) { delete(req, "test") }
+
+func dropHuaweiTestAuthorization(req map[string]any) {
+	for _, imp := range req["imp"].([]any) {
+		ext := imp.(map[string]any)["ext"].(map[string]any)
+		if bidderExt, ok := ext["bidder"].(map[string]any); ok {
+			delete(bidderExt, "isTestAuthorization")
+		}
+	}
+}
+
+func loadMockBidRequest(t *testing.T, fixture string, mutate func(map[string]any)) *openrtb2.BidRequest {
+	t.Helper()
+	raw, err := os.ReadFile(fixture)
+	require.NoError(t, err)
+	var doc struct {
+		MockBidRequest map[string]any `json:"mockBidRequest"`
+	}
+	require.NoError(t, json.Unmarshal(raw, &doc))
+	if mutate != nil {
+		mutate(doc.MockBidRequest)
+	}
+	reqJSON, err := json.Marshal(doc.MockBidRequest)
+	require.NoError(t, err)
+	var req openrtb2.BidRequest
+	require.NoError(t, json.Unmarshal(reqJSON, &req))
+	return &req
+}
+
+func makeRequestsFingerprint(t *testing.T, bidder adapters.Bidder, req *openrtb2.BidRequest, reqInfo adapters.ExtraRequestInfo) string {
+	t.Helper()
+	reqs, errs := bidder.MakeRequests(req, &reqInfo)
+	require.Empty(t, errs, "MakeRequests errors: %v", errors.Join(errs...))
+	require.NotEmpty(t, reqs)
+	var b strings.Builder
+	for _, r := range reqs {
+		b.WriteString(r.Method + " " + r.Uri + "\n")
+		names := make([]string, 0, len(r.Headers))
+		for name := range r.Headers {
+			names = append(names, name)
+		}
+		sort.Strings(names)
+		for _, name := range names {
+			b.WriteString(name + ": " + strings.Join(r.Headers[name], ",") + "\n")
+		}
+		b.Write(r.Body)
+		b.WriteString("\n")
+	}
+	return b.String()
+}
