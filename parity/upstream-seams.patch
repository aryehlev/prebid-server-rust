+// runAMPFixture runs an /openrtb2/amp sample request the way
+// TestGoodAmpRequests does.
+func runAMPFixture(t *testing.T, file string, traced bool) parityRun {
+	t.Helper()
+	test := loadAMPFixture(t, file)
+	req := httptest.NewRequest("GET", fmt.Sprintf("/openrtb2/auction/amp?%s", test.Query), nil)
+	tagID := req.URL.Query().Get("tag_id")
+	require.NotEmpty(t, tagID)
+	test.StoredRequest = map[string]json.RawMessage{tagID: test.BidRequest}
+	test.endpointType = AMP_ENDPOINT
+	cfg := &config.Configuration{MaxRequestSize: maxSize, GDPR: config.GDPR{Enabled: true}}
+	if test.Config != nil {
+		cfg.BlockedApps = test.Config.BlockedApps
+		cfg.BlockedAppsLookup = test.Config.getBlockedAppLookup()
+		cfg.AccountRequired = test.Config.AccountRequired
+	}
+
+	handler, ex, bidServers, currencyServer, err := buildTestEndpoint(test, cfg)
+	require.NoError(t, err)
+	defer closeServers(bidServers, currencyServer)
+
+	recorder, snap := serve(t, handler, req, traced)
+	require.Equal(t, test.ExpectedReturnCode, recorder.Code, recorder.Body.String())
+	return parityRun{code: recorder.Code, body: recorder.Body.String(), validated: marshalJSON(t, ex.actualValidatedBidReq), trace: snap}
