+// TestParityRateUncertaintyMatchesDraw checks each predicate against its draw:
+// a rate is uncertain exactly when some draw value gives each outcome.
+func TestParityRateUncertaintyMatchesDraw(t *testing.T) {
+	outcomes := func(n int, f func(draw int) bool) (seenTrue, seenFalse bool) {
+		for d := 0; d < n; d++ {
+			if f(d) {
+				seenTrue = true
+			} else {
+				seenFalse = true
+			}
+		}
+		return
+	}
+	for rate := -2; rate <= 102; rate++ {
+		r := rate
+		yes, no := outcomes(skipRateMax+1, func(d int) bool { return r >= d })
+		if r != 0 { // shouldSkipFloors returns early for a zero rate
+			assert.Equal(t, yes && no, skipRateUncertain(r), "skip rate %d", r)
+		}
+		yes, no = outcomes(dataRateMax, func(d int) bool { return d < r })
+		assert.Equal(t, yes && no, dataRateUncertain(r), "data rate %d", r)
+		for _, acct := range []int{-1, 0, 1, 50, 99, 100, 101} {
+			a := acct
+			yes, no = outcomes(enforceRateMax, func(d int) bool {
+				return (r == 0 || d < r) && (a == 0 || d < a)
+			})
+			assert.Equal(t, yes && no, enforceRateUncertain(r, a), "enforce rates %d/%d", r, a)
+		}
+	}
+}
