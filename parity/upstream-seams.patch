new file mode 100644
index 0000000000000000000000000000000000000000..7818298020093ec4ffff510d71fb92fa3df5d617
--- /dev/null
+++ b/privacysandbox/topics_parity_test.go
@@ -0,0 +1,57 @@
+package privacysandbox
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/prebid/openrtb/v20/openrtb2"
+	"github.com/prebid/prebid-server/v4/parity/fakes"
+	"github.com/prebid/prebid-server/v4/util/jsonutil"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestParityTopicsOrder: in parity mode the user.data entries that the
+// Sec-Browsing-Topics header adds come in ascending segtax, then segclass
+// (byte) order, and the segment IDs of every entry, new or merged into an
+// entry of the request, in ascending order (fakes.json orders
+// topics_user_data). Without the fakes they follow Go's map iteration.
+func TestParityTopicsOrder(t *testing.T) {
+	const domain = "topics.parity.test"
+
+	ext := func(segTax int, segClass string) json.RawMessage {
+		raw, err := jsonutil.Marshal(Topic{SegTax: segTax, SegClass: segClass})
+		require.NoError(t, err)
+		return raw
+	}
+	segments := func(ids ...string) []openrtb2.Segment {
+		out := make([]openrtb2.Segment, 0, len(ids))
+		for _, id := range ids {
+			out = append(out, openrtb2.Segment{ID: id})
+		}
+		return out
+	}
+
+	header := []Topic{
+		{SegTax: 601, SegClass: "7", SegIDs: []int{9, 3, 5, 1, 7, 8, 2, 4, 6}},
+		{SegTax: 600, SegClass: "2", SegIDs: []int{8, 6, 4, 2}},
+		{SegTax: 600, SegClass: "10", SegIDs: []int{5, 3, 1}},
+		{SegTax: 602, SegClass: "1", SegIDs: []int{12, 4, 11, 10}},
+	}
+	request := func() []openrtb2.Data {
+		return []openrtb2.Data{{Name: domain, Segment: segments("4"), Ext: ext(602, "1")}}
+	}
+	want := []openrtb2.Data{
+		{Name: domain, Segment: segments("4", "10", "11", "12"), Ext: ext(602, "1")},
+		{Name: domain, Segment: segments("1", "3", "5"), Ext: ext(600, "10")},
+		{Name: domain, Segment: segments("2", "4", "6", "8"), Ext: ext(600, "2")},
+		{Name: domain, Segment: segments("1", "2", "3", "4", "5", "6", "7", "8", "9"), Ext: ext(601, "7")},
+	}
+
+	fakes.Uninstall()
+	fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+	for range 20 {
+		assert.Equal(t, want, UpdateUserDataWithTopics(request(), header, domain))
+	}
