+func marshalJSON(t *testing.T, v any) string {
+	t.Helper()
+	raw, err := jsonutil.Marshal(v)
+	require.NoError(t, err)
+	return string(raw)
+}
+
+// assertStages checks that want is captured and every other endpoint stage is
+// not_reached, and that the trace is a valid trace document.
+func assertStages(t *testing.T, tr *parity.Trace, want []parity.StageID) {
+	t.Helper()
+	captured := map[parity.StageID]bool{}
+	for _, stage := range want {
+		captured[stage] = true
+	}
+	for _, stage := range endpointStages {
+		expected := parity.StageNotReached
+		if captured[stage] {
+			expected = parity.StageCaptured
+		}
+		assert.Equal(t, expected, tr.StageStatus[stage], "stage %s", stage)
+	}
+	assert.Empty(t, tr.Notes, "no snapshot, marshal or dump failed")
+	raw, err := json.Marshal(tr)
+	require.NoError(t, err)
+	assert.NoError(t, schema.Validate(raw), "trace document")
+}
+
+func stageJSON(t *testing.T, tr *parity.Trace, stage parity.StageID) string {
+	t.Helper()
+	e, ok := tr.Stages[stage][parity.UnkeyedStage]
+	require.True(t, ok, "stage %s not recorded", stage)
+	return string(e.JSON)
+}
