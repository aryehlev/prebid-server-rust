new file mode 100644
index 0000000000000000000000000000000000000000..3e85c08de0c1ec4a0f65a9b0e4eba4204c0ae20f
--- /dev/null
+++ b/floors/parity.go
@@ -0,0 +1,79 @@
+package floors
+
+import (
+	"github.com/prebid/prebid-server/v4/openrtb_ext"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/stagedata"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+)
+
+// This file holds the floors package's parity helpers (branch only). Without a
+// parity case in flight (trace.Current() == nil) each helper is exactly the
+// original computation, so production behaviour is unchanged.
+
+// recordEnrich records floors.enrich right after updateFloorsInRequest rebuilt
+// the request, so the snapshot never forces a rebuild of its own.
+func recordEnrich(bidRequestWrapper *openrtb_ext.RequestWrapper, priceFloors *openrtb_ext.PriceFloorRules) {
+	s := trace.Current()
+	if s == nil || bidRequestWrapper == nil {
+		return
+	}
+	s.Record(parity.StageFloorsEnrich, "", stagedata.FloorsEnrich{Request: bidRequestWrapper.BidRequest, Floors: priceFloors})
+}
+
+// decideRate is the parity decision for a draw against configured rates
+// (floors.skip, floors.data_rate, floors.enforce). Without a parity case in
+// flight it is exactly draw() and uncertain is never evaluated. In a parity case
+// the envelope may pin the outcome only when uncertain reports that the rates
+// leave it to chance (see trace.Session.DecideChance).
+func decideRate(point parity.DecisionID, uncertain func() bool, draw func() bool) bool {
+	s := trace.Current()
+	if s == nil {
+		return draw()
+	}
+	return s.DecideChance(point, uncertain(), draw)
+}
+
+// skipRateUncertain reports whether shouldSkipFloors' draw (skipRate >=
+// rand.Intn(skipRateMax+1)) can go both ways: a rate of skipRateMax or more
+// always skips, and a rate of skipRateMin or less never does.
+func skipRateUncertain(skipRate int) bool {
+	return skipRate > skipRateMin && skipRate < skipRateMax
+}
+
+// dataRateUncertain reports whether useFetchedData's draw (rand.Intn(dataRateMax)
+// < rate) can go both ways: a rate of dataRateMax or more always uses the
+// fetched data, and a rate of 0 or less never does.
+func dataRateUncertain(rate int) bool {
+	return rate > 0 && rate < dataRateMax
+}
+
+// enforceRateUncertain reports whether isSatisfiedByEnforceRate's draw can go
+// both ways. Each rate is satisfied by every draw in [0, enforceRateMax) when it
+// is 0 or at least enforceRateMax, and by none when it is negative; the outcome
+// is the conjunction of the request and account rates.
+func enforceRateUncertain(requestRate, accountRate int) bool {
+	sometimes, always := true, true
+	for _, rate := range []int{requestRate, accountRate} {
+		switch {
+		case rate < 0:
+			sometimes = false
+		case rate != 0 && rate < enforceRateMax:
+			always = false
+		}
+	}
+	return sometimes && !always
+}
+
+// winningModelGroup is the original weighted pick of selectFloorModelGroup:
+// the first group (in sorted order) at which the running weight sum reaches
+// winWeight, or 0 when none does.
+func winningModelGroup(modelGroups []openrtb_ext.PriceFloorModelGroup, winWeight int) int {
+	for i, modelGroup := range modelGroups {
+		winWeight -= *modelGroup.ModelWeight
+		if winWeight <= 0 {
+			return i
+		}
+	}
+	return 0
+}
