+			run:  func() any { return shouldSkipFloors(0, 0, 10, constant(0)) },
+			want: true, wantSource: parity.DecisionSourceRNG,
+		},
+		{
+			name:      "skip is not consulted when every skip rate is zero",
+			decisions: map[string]string{string(parity.DecisionFloorsSkip): "1"},
+			run:       func() any { return shouldSkipFloors(0, 0, 0, constant(0)) },
+			want:      false,
+		},
+		{
+			name:      "data rate override 0 keeps request data",
+			decisions: map[string]string{string(parity.DecisionFloorsDataRate): "0"},
+			run:       func() any { return useFetchedData(&fifty) },
+			want:      false, wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
+			name:      "data rate override 1 uses fetched data",
+			decisions: map[string]string{string(parity.DecisionFloorsDataRate): "1"},
+			run:       func() any { return useFetchedData(&fifty) },
+			want:      true, wantSource: parity.DecisionSourceEnvelope,
+		},
+		{
+			name:      "data rate 100 always uses fetched data whatever the envelope pins",
+			decisions: map[string]string{string(parity.DecisionFloorsDataRate): "0"},
+			run:       func() any { return useFetchedData(&hundred) },
