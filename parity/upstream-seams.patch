@@ -0,0 +1,123 @@
+package usersync
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/prebid/prebid-server/v4/config"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/fakes"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestParityShuffleDecision(t *testing.T) {
+	input := []string{"a", "b", "c", "d", "e", "f", "g", "h"}
+	tests := []struct {
+		name         string
+		override     string
+		wantIdentity bool
+		wantSource   string
+		wantValue    string
+		wantNotes    int
+	}{
+		{name: "identity keeps the order", override: `"identity"`, wantIdentity: true, wantSource: parity.DecisionSourceEnvelope, wantValue: `"identity"`},
+		{name: "no override shuffles", wantSource: parity.DecisionSourceRNG, wantValue: `"rng"`},
+		{name: "unknown override shuffles", override: `"reverse"`, wantSource: parity.DecisionSourceRNG, wantValue: `"rng"`, wantNotes: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			env := &parity.Envelope{}
+			if tt.override != "" {
+				env.Decisions = map[string]json.RawMessage{string(parity.DecisionUsersyncShuffle): json.RawMessage(tt.override)}
+			}
+			sess, end := trace.Begin(env)
+			defer end()
+
+			got := append([]string(nil), input...)
+			randomShuffler{}.shuffle(got)
+			if tt.wantIdentity {
+				assert.Equal(t, input, got)
+			} else {
+				assert.ElementsMatch(t, input, got)
+			}
+			decisions := sess.Snapshot().Decisions
+			require.Len(t, decisions, 1)
+			assert.Equal(t, parity.DecisionUsersyncShuffle, decisions[0].Point)
+			assert.Equal(t, tt.wantSource, decisions[0].Source)
+			assert.JSONEq(t, tt.wantValue, string(decisions[0].Value))
+			assert.Len(t, decisions[0].Notes, tt.wantNotes)
+		})
+	}
+}
+
+// TestParityShuffleOutsideACase: outside a parity case the shuffle draws from
+// the real random source, unless parity mode installed its fakes, which keep
+// the order on the main port.
+func TestParityShuffleOutsideACase(t *testing.T) {
+	input := []string{"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"}
+
+	shuffled := false
+	for i := 0; i < 20 && !shuffled; i++ {
+		got := append([]string(nil), input...)
+		randomShuffler{}.shuffle(got)
+		assert.ElementsMatch(t, input, got)
+		shuffled = !assert.ObjectsAreEqual(input, got)
+	}
+	assert.True(t, shuffled, "without the fakes the order must be drawn")
+
+	fakes.Uninstall()
+	fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+	got := append([]string(nil), input...)
+	randomShuffler{}.shuffle(got)
+	assert.Equal(t, input, got)
+}
+
+// TestParityChooserSortsSyncers: in parity mode NewChooser lists the syncers
+// in ascending bidder order (fakes.json orders usersync_bidders), which the
+// shuffle then keeps under usersync.shuffle=identity.
+func TestParityChooserSortsSyncers(t *testing.T) {
+	lookup := map[string]Syncer{}
+	for _, b := range []string{"pubmatic", "appnexus", "rubicon", "33across", "adnxs", "ix", "openx", "criteo"} {
+		lookup[b] = fakeSyncer{key: b}
+	}
+
+	fakes.Uninstall()
+	fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+	chooser := NewChooser(lookup, map[string]struct{}{}, nil).(standardChooser)
+	assert.Equal(t, []string{"33across", "adnxs", "appnexus", "criteo", "ix", "openx", "pubmatic", "rubicon"}, chooser.biddersAvailable)
+}
+
+// TestParityCookieClock: in parity mode every uids cookie time is the fake
+// clock: the cookie Expires, the per-uid expires a sync writes, and the
+// liveness of the uids a request carries.
+func TestParityCookieClock(t *testing.T) {
+	fakes.Uninstall()
+	src := fakes.Install()
+	t.Cleanup(fakes.Uninstall)
+	now := src.Now()
+
+	cookie := NewCookie()
+	require.NoError(t, cookie.Sync("adnxs", "id"))
+	assert.Equal(t, now.Add(uidTTL), cookie.uids["adnxs"].Expires)
+
+	cookie.uids["before"] = UIDEntry{UID: "x", Expires: now.Add(-time.Millisecond)}
+	cookie.uids["after"] = UIDEntry{UID: "y", Expires: now.Add(time.Millisecond)}
+	_, _, live := cookie.GetUID("before")
+	assert.False(t, live)
+	assert.True(t, cookie.HasLiveSync("after"))
+	delete(cookie.uids, "after")
+	delete(cookie.uids, "adnxs")
+	assert.False(t, cookie.HasAnyLiveSyncs())
+
+	w := httptest.NewRecorder()
+	host := &config.HostCookie{TTL: 90}
+	WriteCookie(w, "v", host, false)
+	assert.Equal(t, "uids=v; Path=/; Expires="+now.Add(host.TTLDuration()).Format(http.TimeFormat), w.Header().Get("Set-Cookie"))
+}
