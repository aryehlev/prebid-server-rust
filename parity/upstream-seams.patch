+// TestParityStagesOnExchangeJSON replays every exchangetest fixture with a
+// parity case in flight. runSpec's own assertions prove recording is
+// behaviour-neutral; the trace must conform to the schema, and bidder.request
+// must hold exactly the request each bidder received.
+func TestParityStagesOnExchangeJSON(t *testing.T) {
+	specFiles, err := os.ReadDir("./exchangetest")
+	require.NoError(t, err)
+	for _, specFile := range specFiles {
+		if !strings.HasSuffix(specFile.Name(), ".json") {
+			continue
+		}
+		fileName := "./exchangetest/" + specFile.Name()
+		t.Run(specFile.Name(), func(t *testing.T) {
+			spec, err := loadFile(fileName)
+			require.NoError(t, err)
+			tr := runSpecTraced(t, fileName, spec)
+
+			doc, err := json.Marshal(tr)
+			require.NoError(t, err)
+			require.NoError(t, schema.Validate(doc), "trace of %s", fileName)
+			assertBidderRequests(t, tr, spec)
+			assert.Equal(t, parity.StageCaptured, tr.StageStatus[parity.StageExchangeResponse])
+		})
+	}
+}
+
+// runSpecTraced runs one exchangetest fixture inside a parity session and
+// returns the recorded trace.
+func runSpecTraced(t *testing.T, fileName string, spec *exchangeSpec) parity.Trace {
+	t.Helper()
+	sess, end := trace.Begin(&parity.Envelope{
+		Schema:        parity.SchemaEnvelope,
+		SchemaVersion: parity.SchemaVersion,
+		CaseID:        fileName,
+		Request:       parity.ExecRequest{Method: http.MethodPost, Path: "/openrtb2/auction", Headers: parity.HeaderList{}},
+	})
+	defer end()
+	assert.NotPanics(t, func() { runSpec(t, fileName, spec) })
+	tr := sess.Snapshot()
+	tr.Build = parity.BuildInfo{GitSHA: "test", Version: "test"}
+	tr.HTTPIn = &parity.HTTPRequest{Method: http.MethodPost, Path: "/openrtb2/auction", Headers: parity.HeaderList{}}
+	tr.HTTPResponse = &parity.HTTPResponse{Status: http.StatusOK, Headers: parity.HeaderList{}, Body: parity.TextBody("{}")}
+	return tr
+}
+
+func assertBidderRequests(t *testing.T, tr parity.Trace, spec *exchangeSpec) {
+	t.Helper()
+	recorded := tr.Stages[parity.StageBidderRequest]
+	for bidder, out := range spec.OutgoingRequests {
+		if out == nil || out.ExpectedRequest == nil {
+			continue
+		}
+		entry, ok := recorded[bidder]
+		if !assert.True(t, ok, "bidder.request[%s] not recorded", bidder) {
+			continue
+		}
+		var got stagedata.BidderRequest
+		require.NoError(t, json.Unmarshal(entry.JSON, &got))
+		want, err := jsonutil.Marshal(out.ExpectedRequest.OrtbRequest)
+		require.NoError(t, err)
+		gotReq, err := jsonutil.Marshal(got.Request)
+		require.NoError(t, err)
+		assert.JSONEq(t, string(want), string(gotReq), "bidder.request[%s].request", bidder)
+		assert.Equal(t, bidder, got.Bidder)
+	}
+}
+
+// parityTestBidder is an adapter with a fixed MakeRequests output whose
+// MakeBids returns one bid per call (priced from the call index).
+type parityTestBidder struct {
+	requests  []*adapters.RequestData
+	makeBids  atomic.Int32
+	bidErrors []error
+}
+
+func (b *parityTestBidder) MakeRequests(*openrtb2.BidRequest, *adapters.ExtraRequestInfo) ([]*adapters.RequestData, []error) {
+	return b.requests, nil
+}
+
+func (b *parityTestBidder) MakeBids(_ *openrtb2.BidRequest, req *adapters.RequestData, _ *adapters.ResponseData) (*adapters.BidderResponse, []error) {
+	b.makeBids.Add(1)
+	resp := adapters.NewBidderResponse()
+	resp.Bids = append(resp.Bids, &adapters.TypedBid{
+		Bid:     &openrtb2.Bid{ID: "bid-" + string(req.Body), ImpID: "imp1", Price: 1},
+		BidType: openrtb_ext.BidTypeBanner,
+	})
+	return resp, b.bidErrors
+}
+
+// countingTransport counts the HTTP requests that reach the network layer.
+type countingTransport struct {
+	calls atomic.Int32
+	next  http.RoundTripper
+}
+
+func (c *countingTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	c.calls.Add(1)
+	if c.next == nil {
+		return nil, errors.New("countingTransport: no network in this test")
+	}
+	return c.next.RoundTrip(req)
+}
+
+func TestParityRequestBidStages(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte(`{"ok":true}`))
+	}))
+	defer server.Close()
+
+	mock := parity.BidderResponseMock{
+		Currency: "USD",
+		Bids:     []parity.TypedBid{{Bid: json.RawMessage(`{"id":"mocked","impid":"imp1","price":3}`), Type: "banner"}},
+	}
+	tests := []struct {
+		name          string
+		mock          parity.MockSpec
+		wantHTTPCalls int32
+		wantMakeBids  int32
+		wantPrices    []float64
+		wantMocked    bool
+	}{
+		{
+			name:          "http level runs the adapter",
+			mock:          parity.MockSpec{},
+			wantHTTPCalls: 2,
+			wantMakeBids:  2,
+			wantPrices:    []float64{2, 2},
+		},
+		{
+			name: "bidder_response mock short-circuits http and MakeBids",
+			mock: parity.MockSpec{
+				Level:           parity.MockLevelBidderResp,
+				BidderResponses: map[string]parity.BidderResponseMock{"appnexus": mock},
+			},
+			wantHTTPCalls: 0,
+			wantMakeBids:  0,
+			wantPrices:    []float64{6},
+			wantMocked:    true,
+		},
+		{
+			name: "bidder_response level without a mock for the bidder uses http",
+			mock: parity.MockSpec{
+				Level:           parity.MockLevelBidderResp,
+				BidderResponses: map[string]parity.BidderResponseMock{"rubicon": mock},
+			},
+			wantHTTPCalls: 2,
+			wantMakeBids:  2,
+			wantPrices:    []float64{2, 2},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			impl := &parityTestBidder{requests: []*adapters.RequestData{
+				{Method: http.MethodPost, Uri: server.URL + "/a", Body: []byte("a"), Headers: http.Header{"Content-Type": {"application/json"}}, ImpIDs: []string{"imp1"}},
+				{Method: http.MethodPost, Uri: server.URL + "/b", Body: []byte("b"), ImpIDs: []string{"imp1"}},
+			}}
+			rt := &countingTransport{next: http.DefaultTransport}
+			bidder := AdaptBidder(impl, &http.Client{Transport: rt}, &config.Configuration{}, &metricsConfig.NilMetricsEngine{}, openrtb_ext.BidderAppnexus, nil, "")
+
+			sess, end := trace.Begin(&parity.Envelope{CaseID: tt.name, Mock: tt.mock})
+			seatBids, _, errs := bidder.requestBid(context.Background(), BidderRequest{
+				BidRequest:     &openrtb2.BidRequest{ID: "r1", Imp: []openrtb2.Imp{{ID: "imp1"}}},
+				BidderName:     openrtb_ext.BidderAppnexus,
+				BidderCoreName: openrtb_ext.BidderAppnexus,
+			}, identityConversions{}, &adapters.ExtraRequestInfo{}, &adscert.NilSigner{},
+				bidRequestOptions{bidAdjustments: map[string]float64{"appnexus": 2}},
+				openrtb_ext.ExtAlternateBidderCodes{}, &hookexecution.EmptyHookExecutor{}, nil)
+			tr := sess.Snapshot()
+			end()
+
+			assert.Empty(t, errs)
+			assert.Equal(t, tt.wantHTTPCalls, rt.calls.Load(), "requests sent")
+			assert.Equal(t, tt.wantMakeBids, impl.makeBids.Load(), "MakeBids calls")
+			require.Len(t, seatBids, 1)
+			var prices []float64
+			for _, bid := range seatBids[0].Bids {
+				prices = append(prices, bid.Bid.Price)
