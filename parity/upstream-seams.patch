new file mode 100644
index 0000000000000000000000000000000000000000..615ceaeb77a4f1cac4c785001c89cb0320ee9728
--- /dev/null
+++ b/exchange/parity_export.go
@@ -0,0 +1,170 @@
+package exchange
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/prebid/openrtb/v20/openrtb2"
+	"github.com/prebid/prebid-server/v4/adapters"
+	"github.com/prebid/prebid-server/v4/config"
+	"github.com/prebid/prebid-server/v4/errortypes"
+	"github.com/prebid/prebid-server/v4/openrtb_ext"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+	"github.com/prebid/prebid-server/v4/util/jsonutil"
+)
+
+// This file is the parity harness seam into the exchange package (branch only).
+// Nothing here runs unless the parity harness calls it.
+
+// BuildParityBidder builds one bidder the way BuildAdapters does: the bidder's
+// (or, for an alias, its parent's) registered Builder is called with adapterCfg
+// and server, and the result is wrapped with adapters.BuildInfoAwareBidder when
+// wrapInfoAware is true. It does not check info.IsEnabled; callers decide.
+func BuildParityBidder(name openrtb_ext.BidderName, adapterCfg config.Adapter, server config.Server, info config.BidderInfo, wrapInfoAware bool) (adapters.Bidder, error) {
+	builders := newAdapterBuilders()
+	if len(info.AliasOf) > 0 {
+		if err := setAliasBuilder(info, builders, name); err != nil {
+			return nil, fmt.Errorf("parity: bidder %s: %w", name, err)
+		}
+	}
+	builder, ok := builders[name]
+	if !ok {
+		return nil, fmt.Errorf("parity: bidder %s: builder not registered", name)
+	}
+	bidder, err := builder(name, adapterCfg, server)
+	if err != nil {
+		return nil, fmt.Errorf("parity: building bidder %s: %w", name, err)
+	}
+	if wrapInfoAware {
+		bidder = adapters.BuildInfoAwareBidder(bidder, info)
+	}
+	return bidder, nil
+}
+
+// ParityAdapterConfig returns the config.Adapter that BuildAdapters derives
+// from a bidder's info.
+func ParityAdapterConfig(info config.BidderInfo) config.Adapter {
+	return buildAdapterInfo(info)
+}
+
+// ParityServerConfig returns the config.Server that BuildAdapters passes to
+// every Builder (kept identical to adapter_util.go BuildAdapters).
+func ParityServerConfig(cfg *config.Configuration) config.Server {
+	return config.Server{ExternalUrl: cfg.ExternalURL, GvlID: cfg.GDPR.HostVendorID, DataCenter: cfg.DataCenter}
+}
+
+// ParityMockBidderResponse returns the envelope's mocked MakeBids output for
+// bidder when a parity case with mock.level=bidder_response is in flight. ok is
+// false when there is no such case or no mock for bidder; the caller then runs
+// the real HTTP call and MakeBids. Mock decoding problems are returned as
+// FailedToUnmarshal errors alongside whatever could be decoded.
+func ParityMockBidderResponse(bidder openrtb_ext.BidderName) (resp *adapters.BidderResponse, errs []error, ok bool) {
+	s := trace.Current()
+	if s == nil || s.Envelope().Mock.EffectiveLevel() != parity.MockLevelBidderResp {
+		return nil, nil, false
+	}
+	mock, found := s.Envelope().Mock.BidderResponses[string(bidder)]
+	if !found {
+		return nil, nil, false
+	}
+	resp, errs = ConvertParityBidderResponse(mock)
+	return resp, errs, true
+}
+
+// ConvertParityBidderResponse converts an envelope bidder-response mock into
+// the MakeBids return values.
+func ConvertParityBidderResponse(mock parity.BidderResponseMock) (*adapters.BidderResponse, []error) {
+	errs := make([]error, 0, len(mock.Errors))
+	for _, spec := range mock.Errors {
+		errs = append(errs, ParityError(spec))
+	}
+	if mock.NilResponse {
+		return nil, errs
+	}
+	resp := &adapters.BidderResponse{Currency: mock.Currency, Bids: make([]*adapters.TypedBid, 0, len(mock.Bids))}
+	for i, mb := range mock.Bids {
+		bid, err := convertParityBid(mb)
+		if err != nil {
+			errs = append(errs, &errortypes.FailedToUnmarshal{Message: fmt.Sprintf("parity bidder_response bids[%d]: %v", i, err)})
+			continue
+		}
+		resp.Bids = append(resp.Bids, bid)
+	}
+	if len(mock.FledgeAuctionConfigs) > 0 {
+		if err := jsonutil.Unmarshal(mock.FledgeAuctionConfigs, &resp.FledgeAuctionConfigs); err != nil {
+			errs = append(errs, &errortypes.FailedToUnmarshal{Message: fmt.Sprintf("parity bidder_response fledge_auction_configs: %v", err)})
+		}
+	}
+	return resp, errs
+}
+
+func convertParityBid(mb parity.TypedBid) (*adapters.TypedBid, error) {
+	if len(mb.Bid) == 0 {
+		return nil, errors.New("missing bid")
+	}
+	typed := &adapters.TypedBid{
+		Bid:          &openrtb2.Bid{},
+		BidType:      openrtb_ext.BidType(mb.Type),
+		Seat:         openrtb_ext.BidderName(mb.Seat),
+		DealPriority: mb.DealPriority,
+	}
+	if err := jsonutil.Unmarshal(mb.Bid, typed.Bid); err != nil {
+		return nil, fmt.Errorf("bid: %w", err)
+	}
+	if len(mb.Video) > 0 {
+		typed.BidVideo = &openrtb_ext.ExtBidPrebidVideo{}
+		if err := jsonutil.Unmarshal(mb.Video, typed.BidVideo); err != nil {
+			return nil, fmt.Errorf("video: %w", err)
+		}
+	}
+	if len(mb.Meta) > 0 {
+		typed.BidMeta = &openrtb_ext.ExtBidPrebidMeta{}
+		if err := jsonutil.Unmarshal(mb.Meta, typed.BidMeta); err != nil {
+			return nil, fmt.Errorf("meta: %w", err)
+		}
+	}
+	return typed, nil
+}
+
+// ParityError builds the errortypes error that carries spec.Code, so injected
+// errors flow through the exchange exactly like adapter-produced ones. Codes
+// without a dedicated type become plain errors (UnknownErrorCode) and warning
+// codes become errortypes.Warning.
+func ParityError(spec parity.ErrorSpec) error {
+	msg := spec.Message
+	switch spec.Code {
+	case errortypes.TimeoutErrorCode:
+		return &errortypes.Timeout{Message: msg}
+	case errortypes.BadInputErrorCode:
+		return &errortypes.BadInput{Message: msg}
+	case errortypes.BlockedAppErrorCode:
+		return &errortypes.BlockedApp{Message: msg}
+	case errortypes.BadServerResponseErrorCode:
+		return &errortypes.BadServerResponse{Message: msg}
+	case errortypes.FailedToRequestBidsErrorCode:
+		return &errortypes.FailedToRequestBids{Message: msg}
+	case errortypes.BidderTemporarilyDisabledErrorCode:
+		return &errortypes.BidderTemporarilyDisabled{Message: msg}
+	case errortypes.AccountDisabledErrorCode:
+		return &errortypes.AccountDisabled{Message: msg}
+	case errortypes.AcctRequiredErrorCode:
+		return &errortypes.AcctRequired{Message: msg}
+	case errortypes.MalformedAcctErrorCode:
+		return &errortypes.MalformedAcct{Message: msg}
+	case errortypes.TmaxTimeoutErrorCode:
+		return &errortypes.TmaxTimeout{Message: msg}
+	case errortypes.FailedToMarshalErrorCode:
+		return &errortypes.FailedToMarshal{Message: msg}
+	case errortypes.FailedToUnmarshalErrorCode:
+		return &errortypes.FailedToUnmarshal{Message: msg}
+	case errortypes.InvalidImpFirstPartyDataErrorCode:
+		return &errortypes.InvalidImpFirstPartyData{Message: msg}
+	case errortypes.BidderTemporarilyThrottledErrorCode:
+		return &errortypes.BidderThrottled{Message: msg}
+	}
+	if spec.Code >= errortypes.InvalidPrivacyConsentWarningCode {
+		return &errortypes.Warning{Message: msg, WarningCode: spec.Code}
+	}
+	return errors.New(msg)
+}
