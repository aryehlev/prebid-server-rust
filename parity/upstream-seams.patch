+func assertAdapterStages(t *testing.T, tr parity.Trace, mocked bool, wantAdjusted int) {
+	t.Helper()
+	var reqs stagedata.AdapterRequests
+	require.NoError(t, json.Unmarshal(tr.Stages[parity.StageAdapterRequests]["appnexus"].JSON, &reqs))
+	require.Len(t, reqs.Requests, 2)
+	assert.Empty(t, reqs.Requests[0].Headers.Values("X-Prebid"), "adapter.requests is pre-injection")
+
+	var final stagedata.AdapterRequests
+	require.NoError(t, json.Unmarshal(tr.Stages[parity.StageAdapterRequestsFinal]["appnexus"].JSON, &final))
+	require.Len(t, final.Requests, 2)
+	assert.NotEmpty(t, final.Requests[0].Headers.Values("X-Prebid"), "adapter.requests_final carries X-Prebid")
+
+	for i, key := range []string{"appnexus#0", "appnexus#1"} {
+		entry, ok := tr.Stages[parity.StageAdapterBids][key]
+		require.True(t, ok, "adapter.bids[%s]", key)
+		var bids stagedata.AdapterBids
+		require.NoError(t, json.Unmarshal(entry.JSON, &bids))
+		assert.Equal(t, final.Requests[i].URI, bids.RequestData.URI, "call key follows MakeRequests order")
+		assert.Equal(t, mocked, bids.Mocked)
+		if mocked && i == 1 {
+			assert.Nil(t, bids.BidderResponse, "the mock enters the auction once")
+		} else {
+			assert.NotNil(t, bids.BidderResponse)
+		}
+	}
+
+	var adjusted stagedata.BidsAdjusted
+	require.NoError(t, json.Unmarshal(tr.Stages[parity.StageBidsAdjusted]["appnexus"].JSON, &adjusted))
