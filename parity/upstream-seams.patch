new file mode 100644
index 0000000000000000000000000000000000000000..e43a5f5f5612929b26ab800c1b6d29114bf30e70
--- /dev/null
+++ b/exchange/parity_turns_test.go
@@ -0,0 +1,114 @@
+package exchange
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/prebid/prebid-server/v4/openrtb_ext"
+	"github.com/prebid/prebid-server/v4/parity"
+	"github.com/prebid/prebid-server/v4/parity/trace"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func bidderRequestsNamed(names ...string) []BidderRequest {
+	out := make([]BidderRequest, 0, len(names))
+	for _, n := range names {
+		out = append(out, BidderRequest{BidderName: openrtb_ext.BidderName(n)})
+	}
+	return out
+}
+
+// TestParityTurnsScope: turns exist only for a parity case with two or more
+// distinct bidders.
+func TestParityTurnsScope(t *testing.T) {
+	tests := []struct {
+		name    string
+		session bool
+		bidders []string
+		want    bool
+	}{
+		{"no parity case", false, []string{"b", "a"}, false},
+		{"one bidder", true, []string{"a"}, false},
+		{"duplicate bidder names", true, []string{"a", "b", "a"}, false},
+		{"two bidders", true, []string{"b", "a"}, true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.session {
+				_, end := trace.Begin(&parity.Envelope{CaseID: t.Name()})
+				t.Cleanup(end)
+			}
+			ctx := context.Background()
+			got := parityTurns(ctx, bidderRequestsNamed(tt.bidders...))
+			assert.Equal(t, tt.want, got != ctx)
+			sorted := append([]string(nil), tt.bidders...)
+			sort.Strings(sorted)
+			for _, b := range sorted {
+				parityTakeTurn(got, openrtb_ext.BidderName(b))()
+			}
+		})
+	}
+}
+
+// TestParityTurnsRunInNameOrder: whatever order the goroutines start in,
+// their turns run one at a time in bidder name order.
+func TestParityTurnsRunInNameOrder(t *testing.T) {
+	_, end := trace.Begin(&parity.Envelope{CaseID: t.Name()})
+	t.Cleanup(end)
+	names := []string{"rocketlab", "gumgum", "openx", "appnexus"}
+	ctx := parityTurns(context.Background(), bidderRequestsNamed(names...))
+	var mu sync.Mutex
+	var order []string
+	var wg sync.WaitGroup
+	for _, n := range names {
+		wg.Add(1)
+		go func(n string) {
+			defer wg.Done()
+			done := parityTakeTurn(ctx, openrtb_ext.BidderName(n))
+			defer done()
+			mu.Lock()
+			order = append(order, n)
+			mu.Unlock()
+		}(n)
+	}
+	wg.Wait()
+	assert.Equal(t, []string{"appnexus", "gumgum", "openx", "rocketlab"}, order)
+}
+
+// TestParityTurnEndsOnce: ending a turn twice (requestBid, then the deferred
+// fallback) starts the next turn once and does not panic.
+func TestParityTurnEndsOnce(t *testing.T) {
+	_, end := trace.Begin(&parity.Envelope{CaseID: t.Name()})
+	t.Cleanup(end)
+	ctx := parityTurns(context.Background(), bidderRequestsNamed("a", "b"))
+	done := parityTakeTurn(ctx, "a")
+	done()
+	assert.NotPanics(t, done)
+	parityTakeTurn(ctx, "b")()
+	var nilTurn *parityTurn
+	assert.NotPanics(t, nilTurn.end)
+}
+
+// TestParityTakeTurnStopsAtDeadline: a bidder whose predecessor never ends its
+// turn starts anyway once the auction context is done.
+func TestParityTakeTurnStopsAtDeadline(t *testing.T) {
+	_, end := trace.Begin(&parity.Envelope{CaseID: t.Name()})
+	t.Cleanup(end)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	t.Cleanup(cancel)
+	ctx = parityTurns(ctx, bidderRequestsNamed("a", "b"))
+	returned := make(chan struct{})
+	go func() {
+		parityTakeTurn(ctx, "b")()
+		close(returned)
+	}()
+	select {
+	case <-returned:
+	case <-time.After(5 * time.Second):
+		require.Fail(t, "parityTakeTurn did not return at the deadline")
+	}
+}
