+// assertSameResponse compares two responses of the same request, ignoring what
+// legitimately differs from run to run: bidder response times, the auction
+// timestamp and the order of seats (built from a map).
+func assertSameResponse(t *testing.T, want, got string) {
+	t.Helper()
+	assert.JSONEq(t, comparableResponse(t, want), comparableResponse(t, got))
+}
+
+func comparableResponse(t *testing.T, body string) string {
+	t.Helper()
+	var doc map[string]any
+	require.NoError(t, json.Unmarshal([]byte(body), &doc), body)
+	exts := []any{doc["ext"]}
+	if ortb2, ok := doc["ortb2"].(map[string]any); ok {
+		exts = append(exts, ortb2["ext"])
+	}
+	for _, e := range exts {
+		if ext, ok := e.(map[string]any); ok {
+			delete(ext, "responsetimemillis")
