+		{code: errortypes.BadServerResponseErrorCode, wantCode: errortypes.BadServerResponseErrorCode},
+		{code: errortypes.FailedToRequestBidsErrorCode, wantCode: errortypes.FailedToRequestBidsErrorCode},
+		{code: errortypes.BidderTemporarilyDisabledErrorCode, wantCode: errortypes.BidderTemporarilyDisabledErrorCode, warning: true},
+		{code: errortypes.AccountDisabledErrorCode, wantCode: errortypes.AccountDisabledErrorCode},
+		{code: errortypes.AcctRequiredErrorCode, wantCode: errortypes.AcctRequiredErrorCode},
